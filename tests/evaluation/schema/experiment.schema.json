{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kent8192/aidash/tests/evaluation/schema/experiment.schema.json",
  "title": "Fixed-task experiment manifest",
  "description": "Everything that identifies one evaluation experiment. Changing any field invalidates direct comparison with results recorded under another value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "tier",
    "created_at",
    "aidash",
    "corpus",
    "memory_corpus",
    "evaluator",
    "model",
    "harness",
    "variants",
    "repeat_count",
    "limits",
    "reproducibility_limitations"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "experiment_id": { "type": "string", "pattern": "^fte-[0-9a-f]{12}$" },
    "tier": { "enum": ["deterministic", "live"] },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "aidash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "dirty",
        "dirty_diff_sha256",
        "binary_sha256",
        "server_revision"
      ],
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": ["boolean", "null"] },
        "dirty_diff_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "server_revision": { "type": ["string", "null"] }
      }
    },
    "corpus": { "$ref": "#/$defs/snapshot" },
    "memory_corpus": { "$ref": "#/$defs/snapshot" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "const": "aidash-fixed-task-evaluator" },
        "version": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "registrations",
        "reported_identities",
        "route",
        "mutable_alias"
      ],
      "properties": {
        "kind": { "enum": ["scripted-fixture", "live-provider"] },
        "registrations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/registration" }
        },
        "reported_identities": {
          "description": "Provider-reported model identities, or null when the tier cannot read them (the live tier today).",
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "requested_routes": { "type": "object" },
        "reported_routes": {
          "type": ["array", "null"],
          "items": { "type": "object" }
        },
        "route": { "type": ["string", "null"] },
        "mutable_alias": { "type": "boolean" }
      }
    },
    "execution_order": { "type": "object" },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compaction",
        "cache_salt",
        "provider_credential",
        "disclosure_approval",
        "jev_classifier"
      ],
      "properties": {
        "compaction": { "type": "string" },
        "cache_salt": { "type": "boolean" },
        "provider_credential": { "type": ["string", "null"] },
        "disclosure_approval": { "type": ["string", "null"] },
        "jev_classifier": { "type": "string" }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "comparison",
          "arm",
          "label",
          "agent",
          "agent_fields",
          "model",
          "tools",
          "skills"
        ],
        "properties": {
          "task": { "type": "string" },
          "comparison": { "type": "string" },
          "arm": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "route_id": { "type": "string" },
          "model_configuration": { "type": "object" },
          "label": { "type": "string" },
          "agent": { "$ref": "#/$defs/registration" },
          "agent_fields": { "type": "object" },
          "model": { "$ref": "#/$defs/registration" },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/$defs/registration" }
          },
          "skills": {
            "type": "array",
            "items": { "$ref": "#/$defs/registration" }
          }
        }
      }
    },
    "repeat_count": { "type": "integer", "minimum": 1, "maximum": 250 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_timeout_seconds",
        "wall_seconds",
        "max_output_tokens",
        "spend_ceiling_nanocredits"
      ],
      "properties": {
        "run_timeout_seconds": { "type": "number", "minimum": 1 },
        "wall_seconds": { "type": "number", "minimum": 1 },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "spend_ceiling_nanocredits": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "reproducibility_limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "files"],
      "properties": {
        "version": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "config_sha256"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model_id": { "type": "string" }
      }
    }
  }
}
