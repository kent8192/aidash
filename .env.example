DATABASE_URL=postgres://aidash:aidash-local@127.0.0.1:54370/aidash_a
NATS_URL=nats://127.0.0.1:42270
AIDASH_NODE_ID=aidash://node-a
# Optional advertised URL; defaults to localhost with AIDASH_BACKEND_PORT.
# AIDASH_ENDPOINT=http://127.0.0.1:18080
# Optional host ports; defaults are 18080 and 5173.
# AIDASH_BACKEND_PORT=18080
# AIDASH_FRONTEND_PORT=5173
AIDASH_API_TOKEN=local-development-token
# Google OAuth / OpenID Connect (Web application client).
# Register http://127.0.0.1:5173/auth/callback as an authorized redirect URI.
# The Google issuer below is the default; no Keycloak service is required.
# AIDASH_OIDC_ISSUER=https://accounts.google.com
# AIDASH_OIDC_CLIENT_ID=your-client-id.apps.googleusercontent.com
# AIDASH_OIDC_CLIENT_SECRET=your-client-secret
# AIDASH_OIDC_PUBLIC_ORIGIN=http://127.0.0.1:5173
# AIDASH_OIDC_SESSION_ABSOLUTE_SECONDS=43200
# AIDASH_OIDC_SESSION_IDLE_SECONDS=1800
AIDASH_SECRET_PEER=local-federation-token-change-me-123456
# Provider credentials are references in Registry, never raw metadata.
# AIDASH_SECRET_OPENROUTER=...
# TypeSafe Jev is used only when execution history needs compaction.
# AIDASH_SECRET_JEV=...
# AIDASH_JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
# AIDASH_JEV_MODEL=jev-latest

# Process-local HTTP admission and optional private Prometheus endpoint.
AIDASH_HTTP_TIMEOUT_SECONDS=30
AIDASH_HTTP_CONCURRENCY=128
AIDASH_SSE_CONNECTIONS=128
AIDASH_SSE_RECONCILE_INTERVAL_MS=5000
AIDASH_SSE_BACKPRESSURE_TIMEOUT_SECONDS=30
AIDASH_AUTH_RATE_BURST=30
AIDASH_AUTH_RATE_PERIOD_MS=2000
AIDASH_API_RATE_BURST=120
AIDASH_API_RATE_PERIOD_MS=100
AIDASH_PEER_RATE_BURST=240
AIDASH_PEER_RATE_PERIOD_MS=50
# AIDASH_METRICS_LISTEN=127.0.0.1:9090

# Optional Provider Credential Store keys; configure sources in server settings.
# Generate an independent Master Key with: openssl rand -hex 32
# Server and worker both need it; manage migrations do not. Keep a separate backup.
# AIDASH_PROVIDER_STORE_MASTER_KEY=<64-hex-character-Master-Key>
# AIDASH_PROVIDER_STORE_MASTER_KEY_OLD=<retired-Master-Key-for-decryption>
# AIDASH_PROVIDER_FINGERPRINT_KEY=<independent-raw-string-of-at-least-32-bytes>
# Key sources may also use mounted files; never name AIDASH_SECRET_* variables.
