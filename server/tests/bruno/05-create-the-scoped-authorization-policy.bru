meta {
  name: Create the scoped authorization policy
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{operator_token}}
}

body:json {
  {
    "expected_revision": 0,
    "bundle": {
      "tenant": "{{tenant}}",
      "subjects": {
        "alice": {
          "kind": "user"
        },
        "bob": {
          "kind": "user"
        }
      },
      "policies": [
        {
          "id": "workspace-owner",
          "effect": "allow",
          "subjects": {
            "ids": [
              "alice"
            ]
          },
          "actions": [
            "workspace.create",
            "workspace.read",
            "workspace.update",
            "task.create",
            "message.create",
            "workspace.events"
          ],
          "resources": {
            "kinds": [
              "workspace"
            ]
          },
          "condition": {
            "op": "eq",
            "left": {
              "source": "resource",
              "path": "/owner"
            },
            "right": {
              "source": "literal",
              "value": "alice"
            }
          }
        },
        {
          "id": "workspace-content",
          "effect": "allow",
          "subjects": {
            "ids": [
              "alice"
            ]
          },
          "actions": [
            "task.read",
            "artifact.read",
            "message.read"
          ],
          "resources": {
            "kinds": [
              "task",
              "artifact",
              "message"
            ]
          },
          "condition": {
            "op": "eq",
            "left": {
              "source": "resource",
              "path": "/owner"
            },
            "right": {
              "source": "literal",
              "value": "alice"
            }
          }
        }
      ]
    }
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().revision).to.equal(1);
  });
}
