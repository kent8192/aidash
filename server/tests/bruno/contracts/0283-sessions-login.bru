meta {
  name: 0283 sessions-login - Reject unsafe return destination https%3A%2F%2Funtrusted.example
  type: http
  seq: 283
}

get {
  url: {{base_url}}/auth/login?return_to=https%3A%2F%2Funtrusted.example
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Exact HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |operator_token|peer_token/); });
  test("Reject unsafe return destination https%3A%2F%2Funtrusted.example contract", function () { expect(res.getBody().error).to.equal("invalid return destination"); });
}
