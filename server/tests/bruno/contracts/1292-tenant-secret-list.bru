meta {
  name: 1292 tenant-secret-list - Missing Store fails closed for the subject
  type: http
  seq: 1292
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/secrets
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |deployment_administrator_token|peer_token/); });
  test("Missing Store fails closed for the subject contract", function () { expect(res.getHeader("cache-control")).to.equal("no-store");expect(res.getBody()).to.eql({error:"Tenant Secrets are not available on this Deployment"}); });
}
