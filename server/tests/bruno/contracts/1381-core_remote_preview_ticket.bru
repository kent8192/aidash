meta {
  name: 1381 core_remote_preview_ticket - Deployment Administrator cannot issue a remote ticket
  type: http
  seq: 1381
}

post {
  url: {{base_url}}/api/runs/11111111-1111-4111-8111-111111111111/preview-tickets
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
  Content-Type: application/json
}

body:text {
  {"kind": "file", "area_id": "11111111-1111-4111-8111-111111111111", "file_id": "11111111-1111-4111-8111-111111111111"}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:{"code": "FORBIDDEN", "message": "forbidden", "retryable": false}}); });
}
