meta {
  name: 0540 workspace-get - Application read preserves the typed response contract
  type: http
  seq: 540
}

get {
  url: {{base_url}}/api/workspaces/{{workspace_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"Artifact":{"properties":{"content":{},"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"id":{"format":"uuid","type":"string"},"idempotency_key":{"type":"string"},"kind":{"type":"string"},"name":{"type":"string"},"run_id":{"description":"The Run that published this Artifact on this Node. Only the Run's own\npublication writes it; Artifacts that people or other Nodes deliver have\nnone. Source citations in its content resolve only against this Run.","format":"uuid","type":["string","null"]},"task_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","task_id","kind","name","content","created_by","idempotency_key","created_at"],"type":"object"},"Event":{"properties":{"created_at":{"format":"date-time","type":"string"},"data":{},"id":{"format":"uuid","type":"string"},"kind":{"type":"string"},"node":{"anyOf":[{"$ref":"#/components/schemas/NodeName"},{"type":"null"}],"description":"The Node of the Workspace or executing Run; none for a Tenant-level event."},"sequence":{"format":"int64","type":"integer"},"workspace_id":{"format":"uuid","type":["string","null"]}},"required":["sequence","id","node","workspace_id","kind","data","created_at"],"type":"object"},"Message":{"properties":{"content":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"id":{"format":"uuid","type":"string"},"idempotency_key":{"type":["string","null"]},"run_id":{"description":"The Run that published this message on this Node. Only the Run's own\npublication writes it; messages that people or other Nodes deliver have\nnone. Source citations in its content resolve only against this Run.","format":"uuid","type":["string","null"]},"sender":{"type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","sender","content","idempotency_key","created_at"],"type":"object"},"NodeName":{"description":"The identifier Aidash assigns to a Node, in the same form as a Tenant name:\n`<adjective>-<noun>-<8 random characters>`. Unique within its Deployment,\nnever changed and never reused.","type":"string"},"Task":{"properties":{"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"dependencies":{"items":{"format":"uuid","type":"string"},"type":"array"},"description":{"type":"string"},"id":{"format":"uuid","type":"string"},"owner":{"type":["string","null"]},"parent_id":{"format":"uuid","type":["string","null"]},"requirements":{},"revision":{"format":"int64","type":"integer"},"status":{"$ref":"#/components/schemas/TaskStatus"},"title":{"type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","title","description","status","requirements","owner","created_by","dependencies","parent_id","revision","created_at"],"type":"object"},"TaskStatus":{"enum":["OPEN","CLAIMED","RUNNING","COMPLETED","FAILED","BLOCKED","CANCELLED","ABANDONED"],"type":"string"},"Workspace":{"properties":{"created_at":{"format":"date-time","type":"string"},"goal":{"type":"string"},"id":{"format":"uuid","type":"string"},"node":{"$ref":"#/components/schemas/NodeName","description":"The Node of its Tenant that the Workspace, its Tasks and its Runs belong to."},"revision":{"format":"int64","type":"integer"},"state":{},"title":{"type":"string"}},"required":["id","node","title","goal","state","revision","created_at"],"type":"object"},"WorkspaceSnapshot":{"properties":{"artifacts":{"items":{"$ref":"#/components/schemas/Artifact"},"type":"array"},"events":{"items":{"$ref":"#/components/schemas/Event"},"type":"array"},"messages":{"items":{"$ref":"#/components/schemas/Message"},"type":"array"},"tasks":{"items":{"$ref":"#/components/schemas/Task"},"type":"array"},"workspace":{"$ref":"#/components/schemas/Workspace"}},"required":["workspace","tasks","artifacts","events","messages"],"type":"object"}},"schema":{"$ref":"#/components/schemas/WorkspaceSnapshot"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody().workspace.revision).to.equal(1);expect(res.getBody().workspace.state).to.eql({bruno:true}); });
}
