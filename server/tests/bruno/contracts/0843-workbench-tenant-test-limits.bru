tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"TenantTestLimits":{"description":"A Tenant's Test Limits as it set them, with the Deployment's ceilings.","properties":{"ceilings":{"$ref":"#/components/schemas/TestLimitCeilings"},"limits":{"$ref":"#/components/schemas/TestLimits2"}},"required":["limits","ceilings"],"type":"object"},"TestLimitCeilings":{"additionalProperties":false,"description":"The Deployment's ceilings on every Tenant's Test Limits (#361). Tests run\non workers the Tenants share, so the Deployment bounds what one Tenant may\ntake, and each Tenant sets its own values within the ceilings.","properties":{"incident_evidence_days":{"format":"int32","type":"integer"},"max_concurrent":{"format":"int32","type":"integer"},"max_duration_secs":{"format":"int32","type":"integer"},"max_input_bytes":{"format":"int32","type":"integer"},"max_output_tokens":{"format":"int32","type":"integer"},"max_steps":{"format":"int32","type":"integer"},"max_total_tokens":{"format":"int32","type":"integer"},"payload_days":{"format":"int32","type":"integer"}},"required":["max_input_bytes","max_output_tokens","max_total_tokens","max_steps","max_duration_secs","max_concurrent","payload_days","incident_evidence_days"],"type":"object"},"TestLimits2":{"additionalProperties":false,"properties":{"incident_evidence_days":{"format":"int32","type":"integer"},"max_concurrent":{"format":"int32","type":"integer"},"max_duration_secs":{"format":"int32","type":"integer"},"max_input_bytes":{"format":"int32","type":"integer"},"max_output_tokens":{"format":"int32","type":"integer"},"max_steps":{"format":"int32","type":"integer"},"max_total_tokens":{"format":"int32","type":"integer"},"payload_days":{"format":"int32","type":"integer"},"revision":{"default":0,"description":"The revision the limits were read at. A write sends it back and fails\nwith a conflict when another write came first.","format":"int64","type":"integer"},"tenant":{"type":"string"}},"required":["tenant","max_input_bytes","max_output_tokens","max_total_tokens","max_steps","max_duration_secs","max_concurrent","payload_days","incident_evidence_days","revision"],"type":"object"}},"schema":{"$ref":"#/components/schemas/TenantTestLimits"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
