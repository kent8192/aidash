meta {
  name: 1206 plan-connection-disconnect - Forged bearer cannot reach a Plan Connection
  type: http
  seq: 1206
}

delete {
  url: {{base_url}}/api/tenants/{{tenant}}/plan-connections/chatgpt
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"expected_revision": 1}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
