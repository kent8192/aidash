meta {
  name: 0111 desktop-start - Start a bound S256 desktop handoff
  type: http
  seq: 45
}

post {
  url: {{base_url}}/auth/desktop/start
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"redirect_uri": "http://127.0.0.1:43217/callback", "state": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss", "code_challenge": "2RMjpSmPO5-BTbKe-qJx8k-9zO390GJJG4q8jge3-2k"}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Start a bound S256 desktop handoff contract", function () { expect(res.getBody()).to.have.all.keys("authorization_url");expect(res.getBody().authorization_url).to.include(bru.getEnvVar("base_url")+"/auth/desktop/authorize?request=");bru.setVar("desktop_authorize_url",res.getBody().authorization_url);const request=res.getBody().authorization_url.split("?request=")[1];expect(request).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);bru.setVar("desktop_request",request); });
}
