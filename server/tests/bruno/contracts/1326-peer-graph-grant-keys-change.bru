meta {
  name: 1326 peer-graph-grant-keys-change - Anonymous receiving-key request is rejected
  type: http
  seq: 1326
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}/peer-graph-grant-keys
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"source_deployment": "aidash://bruno-unknown", "source_identity": "11111111-1111-4111-8111-111111111111", "action": "quarantine", "expected_keys_revision": 1, "expected_authorization_revision": 1}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
