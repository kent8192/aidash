meta {
  name: 1341 tenant-registration-keys-change - Anonymous receiving-key request is rejected
  type: http
  seq: 1341
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/nodes/{{tenant_node}}/registration-keys
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"source_node": "aidash://bruno-unknown/brave-otter-k3m9q2xa", "action": "quarantine", "expected_keys_revision": 1, "expected_authorization_revision": 1}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
