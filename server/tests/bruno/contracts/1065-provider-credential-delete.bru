meta {
  name: 1065 provider-credential-delete - Forged bearer cannot manage Provider Credentials
  type: http
  seq: 1065
}

delete {
  url: {{base_url}}/api/tenants/{{tenant}}/provider-credentials/11111111-1111-4111-8111-111111111111
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"expected_revision": 0}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
