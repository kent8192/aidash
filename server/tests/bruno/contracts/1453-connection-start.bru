meta {
  name: 1453 connection-start - Forged bearer cannot access OAuth Connections
  type: http
  seq: 1453
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/connections/authorizations
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"resource": "https://mcp.example/mcp"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
