meta {
  name: 0834 peer-transaction-decision - Authenticated peer rejects malformed resource IDs
  type: http
  seq: 834
}

get {
  url: {{base_url}}/federation/v0.1/transactions/not-a-uuid/decision
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{peer_token}}
  X-Aidash-Node: {{peer_node}}
  X-Aidash-Protocol: 0.1
}

tests {
  test("Exact HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |operator_token|peer_token/); });
}
