meta {
  name: 1338 approval-observation-report - Subject Credential bearer cannot administer the observer
  type: http
  seq: 1338
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/approval-observations/report?start=2026-10-01T00:00:00Z&end=2026-10-02T00:00:00Z
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
