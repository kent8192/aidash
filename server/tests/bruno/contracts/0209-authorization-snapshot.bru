meta {
  name: 0209 authorization-snapshot - Application read preserves the typed response contract
  type: http
  seq: 209
}

get {
  url: {{base_url}}/api/authorization/{{tenant}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
