get {
  url: {{base_url}}/api/authorization/{{tenant}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{operator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"$ref":"#/components/schemas/Snapshot"},"definitions":{"Snapshot":{"type":"object","required":["revision","bundle"],"properties":{"bundle":{"$ref":"#/components/schemas/PolicyBundle"},"revision":{"type":"integer","format":"int64"}}},"PolicyBundle":{"type":"object","required":["tenant","subjects","groups","roles","policies"],"properties":{"groups":{"type":"object","default":{},"additionalProperties":{"$ref":"#/components/schemas/Group"}},"policies":{"type":"array","items":{"$ref":"#/components/schemas/Policy"},"default":[]},"roles":{"type":"object","default":{},"additionalProperties":{"$ref":"#/components/schemas/Role"}},"subjects":{"type":"object","default":{},"additionalProperties":{"$ref":"#/components/schemas/Subject"}},"tenant":{"type":"string"}},"additionalProperties":false},"Group":{"type":"object","required":["roles"],"properties":{"roles":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true}},"additionalProperties":false},"Policy":{"type":"object","required":["id","effect","subjects","actions","resources","condition"],"properties":{"actions":{"type":"array","items":{"type":"string"},"uniqueItems":true},"condition":{"anyOf":[{"$ref":"#/components/schemas/Condition"},{"type":"null"}]},"effect":{"$ref":"#/components/schemas/Effect"},"id":{"type":"string"},"resources":{"$ref":"#/components/schemas/ResourceSelector"},"subjects":{"$ref":"#/components/schemas/SubjectSelector"}},"additionalProperties":false},"Condition":{"oneOf":[{"type":"object","required":["op","conditions"],"properties":{"conditions":{"type":"array","items":{"$ref":"#/components/schemas/Condition"}},"op":{"type":"string","enum":["all"]}},"additionalProperties":false},{"type":"object","required":["op","conditions"],"properties":{"conditions":{"type":"array","items":{"$ref":"#/components/schemas/Condition"}},"op":{"type":"string","enum":["any"]}},"additionalProperties":false},{"type":"object","required":["op","left","right"],"properties":{"left":{"$ref":"#/components/schemas/Operand"},"op":{"type":"string","enum":["eq"]},"right":{"$ref":"#/components/schemas/Operand"}},"additionalProperties":false},{"type":"object","required":["op","left","right"],"properties":{"left":{"$ref":"#/components/schemas/Operand"},"op":{"type":"string","enum":["not_eq"]},"right":{"$ref":"#/components/schemas/Operand"}},"additionalProperties":false},{"type":"object","required":["op","left","right"],"properties":{"left":{"$ref":"#/components/schemas/Operand"},"op":{"type":"string","enum":["contains"]},"right":{"$ref":"#/components/schemas/Operand"}},"additionalProperties":false},{"type":"object","required":["op","value"],"properties":{"op":{"type":"string","enum":["exists"]},"value":{"$ref":"#/components/schemas/Operand"}},"additionalProperties":false}]},"Operand":{"oneOf":[{"type":"object","required":["source","path"],"properties":{"path":{"type":"string"},"source":{"type":"string","enum":["subject"]}},"additionalProperties":false},{"type":"object","required":["source","path"],"properties":{"path":{"type":"string"},"source":{"type":"string","enum":["resource"]}},"additionalProperties":false},{"type":"object","required":["source","path"],"properties":{"path":{"type":"string"},"source":{"type":"string","enum":["environment"]}},"additionalProperties":false},{"type":"object","required":["source","value"],"properties":{"source":{"type":"string","enum":["literal"]},"value":{}},"additionalProperties":false}]},"Effect":{"type":"string","enum":["allow","deny"]},"ResourceSelector":{"type":"object","required":["kinds","ids"],"properties":{"ids":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true},"kinds":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"additionalProperties":false},"SubjectSelector":{"type":"object","required":["any","ids","groups","roles","kinds"],"properties":{"any":{"type":"boolean","default":false},"groups":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true},"ids":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true},"kinds":{"type":"array","items":{"$ref":"#/components/schemas/SubjectKind"},"default":[],"uniqueItems":true},"roles":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true}},"additionalProperties":false},"SubjectKind":{"type":"string","enum":["user","agent","node","service"]},"Role":{"type":"object","required":["inherits"],"properties":{"inherits":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true}},"additionalProperties":false},"Subject":{"type":"object","required":["kind","groups","roles","attributes","enabled","delegated_by"],"properties":{"attributes":{"default":{}},"delegated_by":{"type":["string","null"]},"enabled":{"type":"boolean","default":true},"groups":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true},"kind":{"$ref":"#/components/schemas/SubjectKind"},"roles":{"type":"array","items":{"type":"string"},"default":[],"uniqueItems":true}},"additionalProperties":false}}}; function valid(value,schema){if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop()]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
