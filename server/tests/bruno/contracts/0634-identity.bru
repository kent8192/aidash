meta {
  name: 0634 identity - Untrusted bearer does not restrict public reads
  type: http
  seq: 634
}

get {
  url: {{base_url}}/.well-known/aidash
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer invalid
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Untrusted bearer does not restrict public reads contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody()).to.be.an("object");expect(res.getBody().id).to.equal(bru.getEnvVar("node_id"));expect(res.getBody().protocol_version).to.equal("0.2"); });
}
