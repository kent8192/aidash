meta {
  name: 1342 tenant-registration-keys-change - Subject bearer has no receiving-record administration authority
  type: http
  seq: 1342
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/nodes/{{tenant_node}}/registration-keys
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
  Content-Type: application/json
}

body:text {
  {"source_node": "aidash://bruno-unknown/brave-otter-k3m9q2xa", "action": "quarantine", "expected_keys_revision": 1, "expected_authorization_revision": 1}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
