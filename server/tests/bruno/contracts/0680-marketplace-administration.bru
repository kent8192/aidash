meta {
  name: 0680 marketplace-administration - Application read preserves the typed response contract
  type: http
  seq: 680
}

get {
  url: {{base_url}}/api/marketplace/administration?tenant={{tenant}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"type":"array","items":{"$ref":"#/components/schemas/MarketplaceInstallationRevision"}},"definitions":{"AgentNormalization":{"type":"object","description":"Read-only registration metadata is compiled by the Node before publication.","required":["schema_version","registry_deployment","compaction_override","bindings"],"properties":{"bindings":{"type":"array","items":{"$ref":"#/components/schemas/NormalizedBinding"}},"compaction_override":{"anyOf":[{"$ref":"#/components/schemas/QualifiedRef"},{"type":"null"}],"description":"Exact explicit compaction replacement, resolved by trusted registration."},"registry_deployment":{"type":"string"},"schema_version":{"type":"integer","format":"uint8","maximum":255,"minimum":0}},"additionalProperties":false},"Binding3":{"type":"object","required":["kind","target","narrow"],"properties":{"alias":{"type":["string","null"]},"exposure":{"anyOf":[{"$ref":"#/components/schemas/BindingExposure"},{"type":"null"}],"description":"Only valid for Tools, bundles and Skills under the `deferred@1` policy."},"kind":{"$ref":"#/components/schemas/BindingKind"},"members":{"type":"array","items":{"type":"string"},"description":"An empty member list binds the entire bundle. IDs are unique within a bundle."},"narrow":{"$ref":"#/components/schemas/Narrowing"},"target":{"$ref":"#/components/schemas/QualifiedRef"}},"additionalProperties":false},"BindingExposure":{"type":"string","description":"Per-Binding exposure under `deferred@1`. Absent means Deferred.","enum":["eager","deferred"]},"BindingKind":{"type":"string","enum":["tool","bundle","skill","memory","source","decider","external_service"]},"BindingOrigin":{"type":"string","description":"Only the registration resolver creates provenance; it is absent from writable Bindings.","enum":["required","default","explicit","skill_support","companion"]},"Concurrency":{"oneOf":[{"type":"string","description":"Every call runs alone, in the model's order.","enum":["sequential"]},{"type":"string","description":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"]}],"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it."},"EntityRef":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string"},"version":{"type":"string"}}},"Entry":{"type":"object","required":["id","version","kind","name","description","capabilities","tags","languages","skills","schema","config"],"properties":{"binding_normalization":{"anyOf":[{"$ref":"#/components/schemas/AgentNormalization"},{"type":"null"}]},"capabilities":{"type":"array","items":{"type":"string"},"default":[]},"config":{"type":"object","default":{},"additionalProperties":true},"description":{"type":"object","additionalProperties":{"type":"string"}},"id":{"type":"string"},"installation":{"anyOf":[{"$ref":"#/components/schemas/MarketplaceProjection"},{"type":"null"}]},"kind":{"type":"string"},"languages":{"type":"array","items":{"type":"string"},"default":[]},"name":{"type":"object","additionalProperties":{"type":"string"}},"schema":{"default":{}},"skills":{"type":"array","items":{"type":"string"},"default":[]},"tags":{"type":"array","items":{"type":"string"},"default":[]},"version":{"type":"string"}},"additionalProperties":false},"MarketplaceDependencyBinding":{"type":"object","required":["source","target"],"properties":{"source":{"$ref":"#/components/schemas/EntityRef"},"target":{"$ref":"#/components/schemas/EntityRef"}},"additionalProperties":false},"MarketplaceInstallation":{"type":"object","required":["id","tenant","package_key","latest_revision","active_revision","activation_revision"],"properties":{"activation_revision":{"type":"integer","format":"int64"},"active_revision":{"type":["integer","null"],"format":"int64"},"id":{"type":"string"},"latest_revision":{"type":"integer","format":"int64"},"package_key":{"type":"string"},"tenant":{"type":"string"}}},"MarketplaceInstallationRevision":{"type":"object","required":["installation","revision","entry","digest","config","dependencies","bindings","secrets","approved","actions"],"properties":{"actions":{"type":"array","items":{"type":"string"}},"approved":{"type":"boolean"},"bindings":{"type":"array","items":{"$ref":"#/components/schemas/MarketplaceDependencyBinding"}},"config":{},"dependencies":{"type":"array","items":{"$ref":"#/components/schemas/EntityRef"}},"digest":{"type":"string"},"entry":{"$ref":"#/components/schemas/Entry"},"installation":{"$ref":"#/components/schemas/MarketplaceInstallation"},"revision":{"type":"integer","format":"int64"},"secrets":{"type":"object","description":"Package slot names mapped to the installing Tenant's Secret names.","additionalProperties":{"type":"string"}}}},"MarketplaceProjection":{"type":"object","required":["contract","tenant","installation","revision"],"properties":{"contract":{"type":"integer","format":"uint8","maximum":255,"minimum":0},"installation":{"type":"string"},"revision":{"type":"integer","format":"int64"},"tenant":{"type":"string"}},"additionalProperties":false},"Narrowing":{"type":"object","description":"No effect, replay, approval or disclosure field is accepted here. Concurrency\nsafety may only be lowered; a claim above the provider's is rejected.","properties":{"allowed_hosts":{"type":["array","null"],"items":{"type":"string"},"uniqueItems":true},"concurrency":{"anyOf":[{"$ref":"#/components/schemas/Concurrency"},{"type":"null"}]},"decision":{"anyOf":[{"$ref":"#/components/schemas/Restrictions"},{"type":"null"}]},"limits":{"type":"object","additionalProperties":{"type":"integer","format":"uint64","minimum":0}},"scope":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},"additionalProperties":false},"NormalizedBinding":{"type":"object","required":["binding","origin"],"properties":{"binding":{"$ref":"#/components/schemas/Binding3"},"origin":{"$ref":"#/components/schemas/BindingOrigin"}},"additionalProperties":false},"QualifiedRef":{"type":"object","required":["registry_deployment","id","version"],"properties":{"id":{"type":"string"},"registry_deployment":{"type":"string"},"version":{"type":"string"}},"additionalProperties":false},"Restrictions":{"type":"object","description":"What a Binding may tighten. A lower threshold takes the conservative action\nat a lower probability: it keeps more content for compaction and blocks more\ncalls for approval. `preserve_recent` and `forbid_apply` apply to compaction\nonly; an approval Decider reads `threshold` and `max_calls_per_run`.","required":["threshold","preserve_recent","forbid_apply","max_calls_per_run"],"properties":{"forbid_apply":{"type":"boolean","default":false},"max_calls_per_run":{"type":["integer","null"],"format":"uint64","description":"A lower per-Run call limit than the Decider version declares.","minimum":0},"preserve_recent":{"type":"integer","format":"uint","description":"Events, or on the Native Projection Version Model Turns, never classified.","default":6,"minimum":0},"threshold":{"type":"string","description":"The probability at which an answer takes the conservative action; lower\nis stricter. A Route's own threshold is intersected in when it is asked.","default":"3fe0000000000000"}},"additionalProperties":false}}}; function valid(value,schema){if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop()]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
