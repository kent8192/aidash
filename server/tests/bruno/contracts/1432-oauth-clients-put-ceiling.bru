meta {
  name: 1432 oauth-clients-put-ceiling - Forged bearer cannot manage OAuth settings
  type: http
  seq: 1432
}

put {
  url: {{base_url}}/api/tenants/{{tenant}}/connection-scope-ceilings/aHR0cHM6Ly9tY3AuZXhhbXBsZS50ZXN0
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"scopes": ["read"]}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
