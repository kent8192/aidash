meta {
  name: 0773 peer-transaction-authority - Require the Federation token
  type: http
  seq: 773
}

get {
  url: {{base_url}}/federation/v0.1/transactions/11111111-1111-4111-8111-111111111111/authority
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Aidash-Protocol: 0.4
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
