meta {
  name: 0117 desktop-exchange - Consumed authorization code cannot be replayed
  type: http
  seq: 51
}

post {
  url: {{base_url}}/auth/desktop/exchange
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"code": "{{desktop_code}}", "state": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss", "verifier": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "redirect_uri": "http://127.0.0.1:43217/callback"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
