meta {
  name: 1412 oauth-clients-put-collection - Forged bearer cannot manage OAuth settings
  type: http
  seq: 1412
}

put {
  url: {{base_url}}/api/tenants/{{tenant}}/oauth-clients
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"owner": "me", "issuer": "https://auth.example.test", "client_id": "fixture"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
