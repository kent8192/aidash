, approval or disclosure field is accepted here. Concurrency\nsafety may only be lowered; a claim above the provider's is rejected.","properties":{"allowed_hosts":{"items":{"type":"string"},"type":["array","null"],"uniqueItems":true},"concurrency":{"anyOf":[{"$ref":"#/components/schemas/Concurrency"},{"type":"null"}]},"decision":{"anyOf":[{"$ref":"#/components/schemas/Restrictions"},{"type":"null"}]},"limits":{"additionalProperties":{"format":"uint64","minimum":0,"type":"integer"},"type":"object"},"scope":{"additionalProperties":{"items":{"type":"string"},"type":"array","uniqueItems":true},"type":"object"}},"type":"object"},"NodeName":{"description":"The identifier Aidash assigns to a Node, in the same form as a Tenant name:\n`<adjective>-<noun>-<8 random characters>`. Unique within its Deployment,\nnever changed and never reused.","type":"string"},"NormalizedBinding":{"additionalProperties":false,"properties":{"binding":{"$ref":"#/components/schemas/Binding3"},"origin":{"$ref":"#/components/schemas/BindingOrigin"}},"required":["binding","origin"],"type":"object"},"Outcome":{"oneOf":[{"description":"The plugin loads; the offending part has no effect.","enum":["ignored"],"type":"string"},{"description":"The component is left out; the rest of the plugin loads.","enum":["skipped"],"type":"string"}]},"PageImageSelection":{"additionalProperties":false,"description":"The page image of an Evidence fragment, by the digest the model was given.","properties":{"evidence_ref":{"type":"string"},"expected_digest":{"type":"string"}},"required":["evidence_ref","expected_digest"],"type":"object"},"PendingCheck":{"additionalProperties":false,"description":"A started Check whose operation has not been recorded as evidence yet.","properties":{"attempt":{"format":"uint32","minimum":0,"type":"integer"},"operation_id":{"format":"uuid","type":"string"},"running_since":{"description":"When the gate first saw the command running. Until then the operation\nis still being dispatched, its sandb