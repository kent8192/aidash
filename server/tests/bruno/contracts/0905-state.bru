meta {
  name: 0905 state - Application read preserves the typed response contract
  type: http
  seq: 905
}

get {
  url: {{base_url}}/api/state
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"AccessProfile":{"oneOf":[{"properties":{"kind":{"enum":["deployment_administrator"],"type":"string"}},"required":["kind"],"type":"object"},{"properties":{"kind":{"enum":["subject"],"type":"string"},"subject":{"type":"string"},"tenant":{"type":"string"}},"required":["kind","tenant","subject"],"type":"object"}]},"ActiveInput":{"additionalProperties":false,"properties":{"deadline":{"format":"date-time","type":"string"},"id":{"type":"string"},"started_at":{"format":"date-time","type":"string"}},"required":["id","started_at","deadline"],"type":"object"},"AgentNormalization":{"additionalProperties":false,"description":"Read-only registration metadata is compiled by the Node before publication.","properties":{"bindings":{"items":{"$ref":"#/components/schemas/NormalizedBinding"},"type":"array"},"compaction_override":{"anyOf":[{"$ref":"#/components/schemas/QualifiedRef"},{"type":"null"}],"description":"Exact explicit compaction replacement, resolved by trusted registration."},"registry_deployment":{"type":"string"},"schema_version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["schema_version","registry_deployment","compaction_override","bindings"],"type":"object"},"ApprovalRef":{"description":"Where the approval a Run waits for is decided.","oneOf":[{"additionalProperties":false,"description":"A capability approval record on this Node (tool call, outbound, Web disclosure).","properties":{"approval_id":{"format":"uuid","type":"string"},"source":{"enum":["capability"],"type":"string"}},"required":["source","approval_id"],"type":"object"},{"additionalProperties":false,"description":"A Run executing for another Node asks that Node through a human request.","properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"expires_at":{"format":"date-time","type":"string"},"key":{"type":"string"},"request_id":{"format":"uuid","type":"string"},"source":{"enum":["home"],"type":"string"}},"required":["source","request_id","key","call","expires_at"],"type":"object"}]},"Artifact":{"properties":{"content":{},"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"id":{"format":"uuid","type":"string"},"idempotency_key":{"type":"string"},"kind":{"type":"string"},"name":{"type":"string"},"run_id":{"description":"The Run that published this Artifact on this Node. Only the Run's own\npublication writes it; Artifacts that people or other Nodes deliver have\nnone. Source citations in its content resolve only against this Run.","format":"uuid","type":["string","null"]},"task_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","task_id","kind","name","content","created_by","idempotency_key","created_at"],"type":"object"},"ArtifactRef":{"additionalProperties":false,"properties":{"reference":{"description":"Path, artifact ID or record reference exactly as it appeared in history.","type":"string"},"revision":{"description":"Revision or digest when history stated one; otherwise empty.","type":"string"}},"required":["reference","revision"],"type":"object"},"Binding3":{"additionalProperties":false,"properties":{"alias":{"type":["string","null"]},"exposure":{"anyOf":[{"$ref":"#/components/schemas/BindingExposure"},{"type":"null"}],"description":"Only valid for Tools, bundles and Skills under the `deferred@1` policy."},"kind":{"$ref":"#/components/schemas/BindingKind"},"members":{"description":"An empty member list binds the entire bundle. IDs are unique within a bundle.","items":{"type":"string"},"type":"array"},"narrow":{"$ref":"#/components/schemas/Narrowing"},"target":{"$ref":"#/components/schemas/QualifiedRef"}},"required":["kind","target","narrow"],"type":"object"},"BindingExposure":{"description":"Per-Binding exposure under `deferred@1`. Absent means Deferred.","enum":["eager","deferred"],"type":"string"},"BindingKind":{"enum":["tool","bundle","skill","memory","source","decider","external_service"],"type":"string"},"BindingOrigin":{"description":"Only the registration resolver creates provenance; it is absent from writable Bindings.","enum":["required","default","explicit","skill_support","companion"],"type":"string"},"BindingSnapshot":{"additionalProperties":false,"properties":{"agent":{"$ref":"#/components/schemas/QualifiedRef"},"agent_plugins":{"description":"The Skills of each Agent Plugin copy the Agent definition takes in, in its order.","items":{"$ref":"#/components/schemas/PinnedAgentPlugin"},"type":"array"},"bindings":{"items":{"$ref":"#/components/schemas/ResolvedBinding"},"type":"array"},"definitions":{"items":{"$ref":"#/components/schemas/ResolvedDefinition"},"type":"array"},"foreign_agents":{"description":"Public Deployment Administrator Agent transports retain the receiver's complete admitted closure.","items":{"$ref":"#/components/schemas/ForeignAgentSnapshot"},"type":"array"},"remote":{"description":"Admission placement determines which implicit defaults must remain excluded.","type":"boolean"},"schema_version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["schema_version","agent","remote","bindings","definitions"],"type":"object"},"CallCheckpoint":{"additionalProperties":false,"description":"Pinned to the logical call at the ToolCallState cursor. A completed wire\nrequest is journaled before this checkpoint advances, so a lost worker never\nresends an uncertain continuation.","properties":{"active":{"anyOf":[{"$ref":"#/components/schemas/ActiveInput"},{"type":"null"}]},"continuation_sends":{"format":"uint32","minimum":0,"type":"integer"},"input":{"anyOf":[{"$ref":"#/components/schemas/RequiredInput"},{"type":"null"}]},"key":{"type":"string"},"responses":{"additionalProperties":true,"type":"object"},"sent":{"anyOf":[{"$ref":"#/components/schemas/SentRound"},{"type":"null"}],"description":"Exact journal identity of the admitted send. Live callbacks own `input`\nand `responses` while waiting, but must never replace this identity."},"waited_millis":{"format":"uint64","minimum":0,"type":"integer"},"wire_pending":{"type":"boolean"}},"required":["key","continuation_sends","wire_pending","input","responses","active","waited_millis"],"type":"object"},"CapabilityIdentity":{"oneOf":[{"additionalProperties":false,"properties":{"registry":{"$ref":"#/components/schemas/QualifiedRef"}},"required":["registry"],"type":"object"},{"additionalProperties":false,"properties":{"direct_skill":{"additionalProperties":false,"properties":{"origin":{"type":"string"},"skill_id":{"format":"uuid","type":"string"}},"required":["skill_id","origin"],"type":"object"}},"required":["direct_skill"],"type":"object"},{"additionalProperties":false,"description":"A tool of a remote MCP server that the Run pinned from an Agent Plugin.","properties":{"agent_plugin_tool":{"additionalProperties":false,"properties":{"plugin":{"$ref":"#/components/schemas/PluginName"},"server":{"$ref":"#/components/schemas/ServerName"},"tool":{"type":"string"}},"required":["plugin","server","tool"],"type":"object"}},"required":["agent_plugin_tool"],"type":"object"}]},"CapabilityKind":{"enum":["tool","skill"],"type":"string"},"CheckOutcome":{"oneOf":[{"enum":["passed"],"type":"string"},{"description":"The Check ran and did not pass.","enum":["failed"],"type":"string"},{"description":"The Check ran past its timeout.","enum":["timed_out"],"type":"string"},{"description":"The Check could not run, or its result is unknown.","enum":["unavailable"],"type":"string"},{"description":"Authority or an approval refused the Check.","enum":["denied"],"type":"string"}]},"CheckSubject":{"additionalProperties":false,"description":"What one Check invocation tested. Evidence counts only for an identical subject.","properties":{"capability_digest":{"description":"Digest of the bound capability definition that ran it.","type":"string"},"check":{"type":"string"},"check_digest":{"description":"[`Check::digest`] of the definition that ran.","type":"string"},"content_digest":{"description":"[`content_digest`] of the files the Check saw.","type":"string"}},"required":["check","check_digest","capability_digest","content_digest"],"type":"object"},"CompletionBasis":{"description":"How a Task came to be completed. Only `Verified` means Checks passed.","enum":["verified","not_required","excepted"],"type":"string"},"CompletionProgress":{"additionalProperties":false,"description":"Run-lifetime Completion Gate state, kept with the Run's context and never\nsent to the model.","properties":{"attempts":{"default":0,"description":"Check attempts started by this Run; numbers each attempt's key.","format":"uint32","minimum":0,"type":"integer"},"basis":{"anyOf":[{"$ref":"#/components/schemas/CompletionBasis"},{"type":"null"}],"description":"How the Run's Task was completed, once it was."},"evidence":{"items":{"$ref":"#/components/schemas/VerificationEvidence"},"type":"array"},"input_seq":{"default":0,"description":"The accepted human input the Repair Allowance belongs to.","format":"int64","type":"integer"},"pending":{"anyOf":[{"$ref":"#/components/schemas/PendingCheck"},{"type":"null"}]},"repairs":{"default":0,"format":"uint32","minimum":0,"type":"integer"},"review":{"description":"The human request of the Completion Review the Run waits on.","format":"uuid","type":["string","null"]},"reviews":{"default":0,"description":"Completion Reviews raised by this Run; numbers each review's request key.","format":"uint32","minimum":0,"type":"integer"},"seconds":{"default":0,"description":"Check time already spent by this Run.","format":"uint64","minimum":0,"type":"integer"},"start_content":{"description":"Content digest when the Run first executed; `None` until recorded.","type":["string","null"]}},"required":["input_seq","repairs","attempts","seconds","reviews"],"type":"object"},"Component":{"oneOf":[{"enum":["manifest","mcp"],"type":"string"},{"additionalProperties":false,"properties":{"skill":{"type":"string"}},"required":["skill"],"type":"object"},{"additionalProperties":false,"properties":{"server":{"type":"string"}},"required":["server"],"type":"object"}]},"Concurrency":{"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it.","oneOf":[{"description":"Every call runs alone, in the model's order.","enum":["sequential"],"type":"string"},{"description":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"],"type":"string"}]},"ContextEvent":{"oneOf":[{"additionalProperties":false,"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"kind":{"enum":["tool"],"type":"string"},"result":{}},"required":["kind","call","result"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["human"],"type":"string"},"request":{"type":"string"},"request_kind":{"type":"string"},"response":{}},"required":["kind","request","request_kind","response"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["model_media_observation"],"type":"string"},"text":{"type":"string"},"through_seq":{"format":"int64","type":["integer","null"]},"truncated":{"type":"boolean"}},"required":["kind","text","through_seq","truncated"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["run_message_read_required"],"type":"string"},"message_ids":{"items":{"format":"uuid","type":"string"},"type":"array"}},"required":["kind","message_ids"],"type":"object"},{"additionalProperties":false,"properties":{"kind":{"enum":["run_message_summary_required"],"type":"string"},"max_bytes":{"format":"uint","minimum":0,"type":["integer","null"]},"reason":{"type":["string","null"]},"through_seq":{"format":"int64","type":"integer"}},"required":["kind","through_seq","max_bytes","reason"],"type":"object"},{"additionalProperties":false,"description":"The accepted response that opens a Model Turn, recorded only for Runs\non the Native Projection Version: its text and the IDs of its tool\ncalls in the model's order. Each executed call's `Tool` event follows\nand carries the call itself. Reasoning output is never recorded.","properties":{"calls":{"items":{"type":"string"},"type":"array"},"epoch":{"format":"int64","type":"integer"},"kind":{"enum":["assistant"],"type":"string"},"text":{"type":"string"}},"required":["kind","epoch","text","calls"],"type":"object"},{"additionalProperties":false,"description":"A final answer cited evidence this Run never received. Recorded once\nper user input (`through_seq` is the Run's observed input sequence); a\nsecond invalid answer to the same input is withheld.","properties":{"instruction":{"type":"string"},"invalid":{"items":{"type":"string"},"type":"array"},"kind":{"enum":["citation_correction_required"],"type":"string"},"through_seq":{"format":"int64","type":"integer"}},"required":["kind","invalid","instruction","through_seq"],"type":"object"},{"additionalProperties":false,"description":"The Completion Gate refused a final answer because a Check did not pass\non the current files. Each one spends the Repair Allowance of the input\nat `through_seq`.","properties":{"checks":{"items":{"$ref":"#/components/schemas/RepairNote"},"type":"array"},"instruction":{"type":"string"},"kind":{"enum":["completion_repair_required"],"type":"string"},"through_seq":{"format":"int64","type":"integer"}},"required":["kind","checks","instruction","through_seq"],"type":"object"}]},"ContextRecoveryFailure":{"description":"Why a Run paused instead of sending or acting on a provider request.\nEach reason is final for its step; none of them is retried as transport.","enum":["source_selection_unavailable","source_selection_forbidden","source_selection_unapproved","source_selection_calls_exhausted","context_unreducible","decider_unapproved","decider_calls_exhausted","decider_unavailable","summary_unavailable","summary_invalid","overflow_retries_exhausted","output_truncated","refused"],"type":"string"},"ContextUsage":{"additionalProperties":false,"properties":{"compactions":{"format":"uint32","minimum":0,"type":"integer"},"context_window":{"format":"uint","minimum":0,"type":"integer"},"exposure":{"anyOf":[{"$ref":"#/components/schemas/ExposureUsage"},{"type":"null"}],"description":"Exposure accounting of a `deferred@1` request."},"input_tokens":{"format":"uint64","minimum":0,"type":"integer"},"output_tokens":{"format":"uint64","minimum":0,"type":"integer"}},"required":["input_tokens","output_tokens","context_window","compactions"],"type":"object"},"ControlSource":{"description":"The kind of actor that last changed a Run's control. It is shown to anyone\nwho can see the Run; the person and the reason are not.","oneOf":[{"description":"A Tenant Subject, or the Run's creation.","enum":["tenant"],"type":"string"},{"description":"A Deployment Administrator's Safety Stop.","enum":["deployment_administrator"],"type":"string"},{"description":"Aidash itself, such as the pause for an identity status outage.","enum":["system"],"type":"string"}]},"Conversation":{"properties":{"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"id":{"format":"uuid","type":"string"},"target":{"type":"string"},"target_kind":{"type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["created_by","id","workspace_id","target","target_kind","created_at"],"type":"object"},"DeferredRead":{"additionalProperties":false,"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"message":{"type":"string"}},"required":["message","call"],"type":"object"},"DegradedContext":{"additionalProperties":false,"description":"What a Run remembers about its Degraded context.","properties":{"count":{"description":"Every step that ran with Degraded context.","format":"uint32","minimum":0,"type":"integer"},"outage":{"description":"Set by a degraded step and cleared by a retrieval that succeeds. While\nit is set a step tries once and degrades at once if that try fails,\ninstead of waiting for the bounded retry again.","type":"boolean"},"recent":{"description":"The latest of those steps, oldest first.","items":{"$ref":"#/components/schemas/DegradedStep"},"type":"array"}},"required":["count","recent","outage"],"type":"object"},"DegradedStep":{"additionalProperties":false,"properties":{"cause":{"$ref":"#/components/schemas/SemanticOutageCause"},"step":{"format":"int32","type":"integer"}},"required":["step","cause"],"type":"object"},"DeploymentIdentity":{"description":"`GET /.well-known/aidash`: the Deployment's identity and its Deployment Key.\nIt names no Node; Nodes belong to Tenants and are not public.","properties":{"endpoint":{"type":"string"},"id":{"type":"string"},"key":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}],"description":"Absent when the Deployment has no Deployment Key, so it cannot federate\nwith other Deployments."},"key_rollover":{"anyOf":[{"$ref":"#/components/schemas/DeploymentRolloverIdentity"},{"type":"null"}],"description":"A published normal transition, containing public keys and proof only."},"protocol_version":{"type":"string"}},"required":["id","endpoint","protocol_version","key"],"type":"object"},"DeploymentKeyIdentity":{"properties":{"id":{"description":"The token `kid`, which a Tenant Administrator types to pin this key.","type":"string"},"public_key_pem":{"description":"SubjectPublicKeyInfo PEM of the Ed25519 public key.","type":"string"}},"required":["id","public_key_pem"],"type":"object"},"DeploymentRolloverIdentity":{"properties":{"activates_at":{"format":"uint64","minimum":0,"type":"integer"},"published_at":{"format":"uint64","minimum":0,"type":"integer"},"retires_at":{"format":"uint64","minimum":0,"type":"integer"},"retiring":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}]},"successor":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}]},"transition":{"type":["string","null"]}},"required":["successor","retiring","published_at","activates_at","retires_at","transition"],"type":"object"},"EntityRef":{"properties":{"id":{"type":"string"},"version":{"type":"string"}},"required":["id","version"],"type":"object"},"Entry":{"additionalProperties":false,"properties":{"binding_normalization":{"anyOf":[{"$ref":"#/components/schemas/AgentNormalization"},{"type":"null"}]},"capabilities":{"default":[],"items":{"type":"string"},"type":"array"},"config":{"additionalProperties":true,"default":{},"type":"object"},"description":{"additionalProperties":{"type":"string"},"type":"object"},"id":{"type":"string"},"installation":{"anyOf":[{"$ref":"#/components/schemas/MarketplaceProjection"},{"type":"null"}]},"kind":{"type":"string"},"languages":{"default":[],"items":{"type":"string"},"type":"array"},"name":{"additionalProperties":{"type":"string"},"type":"object"},"schema":{"default":{}},"skills":{"default":[],"items":{"type":"string"},"type":"array"},"tags":{"default":[],"items":{"type":"string"},"type":"array"},"version":{"type":"string"}},"required":["id","version","kind","name","description","capabilities","tags","languages","skills","schema","config"],"type":"object"},"EstimateView":{"description":"Run inspection's view of the pinned Estimate Snapshot. It omits the sample\ncount: on a shared Deployment, its growth reveals other Tenants' use of\nthe same model.","properties":{"demoted":{"type":"boolean"},"encoding":{"anyOf":[{"$ref":"#/components/schemas/TokenEncoding"},{"type":"null"}],"description":"The Token Encoding a tokenized snapshot pinned."},"estimator":{"type":"string"},"margin_permille":{"format":"uint32","minimum":0,"type":["integer","null"]},"ratio_ppm":{"format":"uint32","minimum":0,"type":["integer","null"]},"step":{"format":"int32","type":"integer"},"version":{"format":"uint32","minimum":0,"type":"integer"}},"required":["step","estimator","version"],"type":"object"},"Event":{"properties":{"created_at":{"format":"date-time","type":"string"},"data":{},"id":{"format":"uuid","type":"string"},"kind":{"type":"string"},"node":{"anyOf":[{"$ref":"#/components/schemas/NodeName"},{"type":"null"}],"description":"The Node of the Workspace or executing Run; none for a Tenant-level event."},"sequence":{"format":"int64","type":"integer"},"workspace_id":{"format":"uuid","type":["string","null"]}},"required":["sequence","id","node","workspace_id","kind","data","created_at"],"type":"object"},"ExecutionSummary":{"additionalProperties":false,"properties":{"content":{"$ref":"#/components/schemas/SummaryContent"},"dependencies":{"$ref":"#/components/schemas/SummaryDependencies"},"digest":{"type":"string"},"policy_version":{"type":"string"},"previous":{"anyOf":[{"$ref":"#/components/schemas/SummaryLink"},{"type":"null"}]},"provider":{"$ref":"#/components/schemas/SummaryProvider"},"source":{"$ref":"#/components/schemas/SummarySource"},"version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["version","content","source","dependencies","policy_version","provider","digest"],"type":"object"},"ExposureState":{"additionalProperties":false,"description":"Durable Exposure set changes of one Run, in load order.","properties":{"loaded":{"default":[],"items":{"$ref":"#/components/schemas/Loaded"},"type":"array"},"pending":{"description":"Load/Unload results of the current model response, in call order. Every\ncall of a response is checked against the Exposure set its request\nadvertised; these take effect with the next inference.","items":{"$ref":"#/components/schemas/ExposureUpdate"},"type":"array"},"unloaded_eager":{"default":[],"description":"Aliases whose eager exposure was withdrawn. An Unload records every\nalias here; only Eager bindings consult it, and a Load removes it.","items":{"type":"string"},"type":"array","uniqueItems":true}},"required":["loaded","unloaded_eager"],"type":"object"},"ExposureUpdate":{"description":"Serialized into tool output `\"exposure_update\"`.","oneOf":[{"additionalProperties":false,"properties":{"load":{"$ref":"#/components/schemas/Loaded"}},"required":["load"],"type":"object"},{"additionalProperties":false,"properties":{"unload":{"additionalProperties":false,"properties":{"alias":{"type":"string"}},"required":["alias"],"type":"object"}},"required":["unload"],"type":"object"}]},"ExposureUsage":{"additionalProperties":false,"properties":{"exposed":{"description":"`(alias, digest)` of every exposed capability, by alias.","items":{"type":"array"},"type":"array"},"metadata_bytes":{"format":"uint","minimum":0,"type":"integer"},"schema_bytes":{"format":"uint","minimum":0,"type":"integer"},"skill_bytes":{"format":"uint","minimum":0,"type":"integer"}},"required":["metadata_bytes","schema_bytes","skill_bytes","exposed"],"type":"object"},"FailureTarget":{"enum":["FAILED","CANCELLED"],"type":"string"},"Finding":{"description":"A part of a plugin that was ignored or skipped, reported next to the accepted ones.","properties":{"component":{"$ref":"#/components/schemas/Component"},"detail":{"type":"string"},"outcome":{"$ref":"#/components/schemas/Outcome"},"reason":{"$ref":"#/components/schemas/Reason"}},"required":["component","outcome","reason","detail"],"type":"object"},"ForeignAgentSnapshot":{"additionalProperties":false,"description":"One authenticated receiver's public closure. Nested foreign or private\ndependencies require their own supported disclosure/admission protocol.","properties":{"agent":{"$ref":"#/components/schemas/QualifiedRef"},"bindings":{"items":{"$ref":"#/components/schemas/ResolvedBinding"},"type":"array"},"definitions":{"items":{"$ref":"#/components/schemas/ResolvedDefinition"},"type":"array"},"schema_version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["schema_version","agent","bindings","definitions"],"type":"object"},"HistoryEntry":{"description":"One Context Projection event with its durable Context Journal sequence.\nThe journal keeps the original event; the projection may later truncate it.","properties":{"event":{"$ref":"#/components/schemas/ContextEvent"},"seq":{"format":"uint64","minimum":0,"type":"integer"}},"required":["seq","event"],"type":"object"},"HomeApproval":{"additionalProperties":false,"description":"The answer a Run executing for another Node received from that Node's\nhuman request, for the exact call it was asked about.","properties":{"approved":{"type":"boolean"},"call":{"$ref":"#/components/schemas/ToolCall"},"key":{"type":"string"}},"required":["key","call","approved"],"type":"object"},"HumanRequest":{"properties":{"answer_by":{"description":"When the Run waiting for this question continues without an answer, if\nits person set an Answer Deadline. Only the dashboard state fills it in,\nfrom the Run's waiting state.","format":"date-time","type":["string","null"]},"answered_by":{"type":["string","null"]},"created_at":{"format":"date-time","type":"string"},"id":{"format":"uuid","type":"string"},"kind":{"type":"string"},"prompt":{"type":"string"},"response":{},"run_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["answered_by","id","workspace_id","run_id","kind","prompt","response","created_at"],"type":"object"},"InputRequest":{"additionalProperties":false,"properties":{"method":{"type":"string"},"params":{}},"required":["method","params"],"type":"object"},"InspectionContext":{"description":"Public inspection omits source content, detail routes, selection manifests\nand delivery receipts; these execution records require source authority.","properties":{"binding_snapshot":{"anyOf":[{"$ref":"#/components/schemas/BindingSnapshot"},{"type":"null"}]},"compactions":{"format":"uint32","minimum":0,"type":"integer"},"completion":{"anyOf":[{"$ref":"#/components/schemas/CompletionProgress"},{"type":"null"}],"description":"Completion Gate state with its Verification Evidence, so a person\nanswering a Completion Review sees each Check's exit code and output."},"estimate":{"anyOf":[{"$ref":"#/components/schemas/EstimateView"},{"type":"null"}],"description":"The Run's pinned Estimate Snapshot, without its sample count."},"execution_summary":{"anyOf":[{"$ref":"#/components/schemas/ExecutionSummary"},{"type":"null"}]},"exposure":{"$ref":"#/components/schemas/ExposureState"},"history":{"items":{"$ref":"#/components/schemas/HistoryEntry"},"type":"array"},"journal":{"$ref":"#/components/schemas/JournalCursor"},"media_inferred_seq":{"format":"int64","type":"integer"},"message_inference_coverage":{"additionalProperties":{"$ref":"#/components/schemas/MessageReadCoverage"},"type":"object"},"message_read_coverage":{"additionalProperties":{"$ref":"#/components/schemas/MessageReadCoverage"},"type":"object"},"plugin_tools":{"anyOf":[{"$ref":"#/components/schemas/PluginTools"},{"type":"null"}],"description":"The plugin tools the Run pinned, with everything left out."},"run_message_summary":{"type":"string"},"run_message_summary_seq":{"format":"int64","type":"integer"},"usage":{"anyOf":[{"$ref":"#/components/schemas/ContextUsage"},{"type":"null"}]}},"required":["run_message_summary","run_message_summary_seq","media_inferred_seq","history","journal","usage","compactions","message_read_coverage","message_inference_coverage"],"type":"object"},"JournalCursor":{"additionalProperties":false,"description":"Context Journal position. Entries up to `imported_through` were recovered\nfrom a projection saved before the journal existed and may already be lossy.\nEntries up to `inferred_through` were present when an inference was accepted.","properties":{"head":{"format":"uint64","minimum":0,"type":"integer"},"imported_through":{"format":"uint64","minimum":0,"type":"integer"},"inferred_through":{"default":0,"format":"uint64","minimum":0,"type":"integer"}},"required":["head","imported_through","inferred_through"],"type":"object"},"LeaseWait":{"description":"Why a Run that no worker currently holds is not being claimed.","oneOf":[{"description":"Only a worker that understands these 