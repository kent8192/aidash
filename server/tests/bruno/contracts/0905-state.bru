meta {
  name: 0905 state - Application read preserves the typed response contract
  type: http
  seq: 905
}

get {
  url: {{base_url}}/api/state
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"AccessProfile":{"oneOf":[{"properties":{"kind":{"enum":["deployment_administrator"],"type":"string"}},"required":["kind"],"type":"object"},{"properties":{"kind":{"enum":["subject"],"type":"string"},"subject":{"type":"string"},"tenant":{"type":"string"}},"required":["kind","tenant","subject"],"type":"object"}]},"ActiveInput":{"additionalProperties":false,"properties":{"deadline":{"format":"date-time","type":"string"},"id":{"type":"string"},"started_at":{"format":"date-time","type":"string"}},"required":["id","started_at","deadline"],"type":"object"},"AgentNormalization":{"additionalProperties":false,"description":"Read-only registration metadata is compiled by the Node before publication.","properties":{"bindings":{"items":{"$ref":"#/components/schemas/NormalizedBinding"},"type":"array"},"compaction_override":{"anyOf":[{"$ref":"#/components/schemas/QualifiedRef"},{"type":"null"}],"description":"Exact explicit compaction replacement, resolved by trusted registration."},"registry_deployment":{"type":"string"},"schema_version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"}},"required":["schema_version","registry_deployment","compaction_override","bindings"],"type":"object"},"ApprovalRef":{"description":"Where the approval a Run waits for is decided.","oneOf":[{"additionalProperties":false,"description":"A capability approval record on this Node (tool call, outbound, Web disclosure).","properties":{"approval_id":{"format":"uuid","type":"string"},"source":{"enum":["capability"],"type":"string"}},"required":["source","approval_id"],"type":"object"},{"additionalProperties":false,"description":"A Run executing for another Node asks that Node through a human request.","properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"expires_at":{"format":"date-time","type":"string"},"key":{"type":"string"},"request_id":{"format":"uuid","type":"string"},"source":{"enum":["home"],"type":"string"}},"required":["source","request_id","key","call","expires_at"],"type":"object"}]},"Artifact":{"properties":{"content":{},"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"id":{"format":"uuid","type":"string"},"idempotency_key":{"type":"string"},"kind":{"type":"string"},"name":{"type":"string"},"run_id":{"description":"The Run that published this Artifact on this Node. Only the Run's own\npublication writes it; Artifacts that people or other Nodes deliver have\nnone. Source citations in its content resolve only against this Run.","format":"uuid","type":["string","null"]},"task_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","task_id","kind","name","content","created_by","idempotency_key","created_at"],"type":"object"},"Binding3":{"additionalProperties":false,"properties":{"alias":{"type":["string","null"]},"exposure":{"anyOf":[{"$ref":"#/components/schemas/BindingExposure"},{"type":"null"}],"description":"Only valid for Tools, bundles and Skills under the `deferred@1` policy."},"kind":{"$ref":"#/components/schemas/BindingKind"},"members":{"description":"An empty member list binds the entire bundle. IDs are unique within a bundle.","items":{"type":"string"},"type":"array"},"narrow":{"$ref":"#/components/schemas/Narrowing"},"target":{"$ref":"#/components/schemas/QualifiedRef"}},"required":["kind","target","narrow"],"type":"object"},"BindingExposure":{"description":"Per-Binding exposure under `deferred@1`. Absent means Deferred.","enum":["eager","deferred"],"type":"string"},"BindingKind":{"enum":["tool","bundle","skill","memory","source","decider","external_service"],"type":"string"},"BindingOrigin":{"description":"Only the registration resolver creates provenance; it is absent from writable Bindings.","enum":["required","default","explicit","skill_support","companion"],"type":"string"},"CallCheckpoint":{"additionalProperties":false,"description":"Pinned to the logical call at the ToolCallState cursor. A completed wire\nrequest is journaled before this checkpoint advances, so a lost worker never\nresends an uncertain continuation.","properties":{"active":{"anyOf":[{"$ref":"#/components/schemas/ActiveInput"},{"type":"null"}]},"continuation_sends":{"format":"uint32","minimum":0,"type":"integer"},"input":{"anyOf":[{"$ref":"#/components/schemas/RequiredInput"},{"type":"null"}]},"key":{"type":"string"},"responses":{"additionalProperties":true,"type":"object"},"sent":{"anyOf":[{"$ref":"#/components/schemas/SentRound"},{"type":"null"}],"description":"Exact journal identity of the admitted send. Live callbacks own `input`\nand `responses` while waiting, but must never replace this identity."},"waited_millis":{"format":"uint64","minimum":0,"type":"integer"},"wire_pending":{"type":"boolean"}},"required":["key","continuation_sends","wire_pending","input","responses","active","waited_millis"],"type":"object"},"Concurrency":{"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it.","oneOf":[{"description":"Every call runs alone, in the model's order.","enum":["sequential"],"type":"string"},{"description":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"],"type":"string"}]},"ConnectionCallState":{"additionalProperties":false,"properties":{"attempt":{"format":"uint32","minimum":0,"type":"integer"},"cause":{"anyOf":[{"$ref":"#/components/schemas/ConnectionCause"},{"type":"null"}]},"refused":{},"resolved":{"default":false,"type":"boolean"},"waited_millis":{"format":"uint64","minimum":0,"type":"integer"}},"required":["cause","resolved","attempt","waited_millis","refused"],"type":"object"},"ConnectionCause":{"description":"A server that can contribute tools after the person connects or consents again.","oneOf":[{"properties":{"error":{"enum":["connection_required"],"type":"string"},"resource":{"type":"string"}},"required":["error","resource"],"type":"object"},{"properties":{"error":{"enum":["connection_scope_insufficient"],"type":"string"},"resource":{"type":"string"},"scope":{"type":["string","null"]}},"required":["error","resource"],"type":"object"}]},"ConnectionRefusal":{"additionalProperties":false,"properties":{"cause":{"$ref":"#/components/schemas/ConnectionCause"},"scopes":{"items":{"type":"string"},"type":"array"},"tool":{"type":"string"}},"required":["cause","tool","scopes"],"type":"object"},"ConnectionWait":{"additionalProperties":false,"properties":{"answer_by":{"format":"date-time","type":"string"},"call":{"anyOf":[{"$ref":"#/components/schemas/ToolCall"},{"type":"null"}],"description":"The builtin's result is recorded only once the person answers."},"key":{"type":"string"},"request_id":{"format":"uuid","type":"string"},"resource":{"type":"string"},"started_at":{"format":"date-time","type":"string"}},"required":["request_id","resource","started_at","answer_by","call","key"],"type":"object"},"ContextRecoveryFailure":{"description":"Why a Run paused instead of sending or acting on a provider request.\nEach reason is final for its step; none of them is retried as transport.","enum":["source_selection_unavailable","source_selection_forbidden","source_selection_unapproved","source_selection_calls_exhausted","context_unreducible","decider_unapproved","decider_calls_exhausted","decider_unavailable","summary_unavailable","summary_invalid","overflow_retries_exhausted","output_truncated","refused"],"type":"string"},"ControlSource":{"description":"The kind of actor that last changed a Run's control. It is shown to anyone\nwho can see the Run; the person and the reason are not.","oneOf":[{"description":"A Tenant Subject, or the Run's creation.","enum":["tenant"],"type":"string"},{"description":"A Deployment Administrator's Safety Stop.","enum":["deployment_administrator"],"type":"string"},{"description":"Aidash itself, such as the pause for an identity status outage.","enum":["system"],"type":"string"}]},"Conversation":{"properties":{"created_at":{"format":"date-time","type":"string"},"created_by":{"type":"string"},"id":{"format":"uuid","type":"string"},"scratch_space_id":{"description":"Fixed when the conversation starts.","format":"uuid","type":"string"},"target":{"type":"string"},"target_kind":{"type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["scratch_space_id","created_by","id","workspace_id","target","target_kind","created_at"],"type":"object"},"DeclinedCall":{"additionalProperties":false,"description":"A call a person declined; the worker answers it with the kind's fixed sentence.","properties":{"key":{"type":"string"},"kind":{"$ref":"#/components/schemas/RefusalKind"}},"required":["key","kind"],"type":"object"},"DeferredRead":{"additionalProperties":false,"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"message":{"type":"string"}},"required":["message","call"],"type":"object"},"DegradedContext":{"additionalProperties":false,"description":"What a Run remembers about its Degraded context.","properties":{"count":{"description":"Every step that ran with Degraded context.","format":"uint32","minimum":0,"type":"integer"},"outage":{"description":"Set by a degraded step and cleared by a retrieval that succeeds. While\nit is set a step tries once and degrades at once if that try fails,\ninstead of waiting for the bounded retry again.","type":"boolean"},"recent":{"description":"The latest of those steps, oldest first.","items":{"$ref":"#/components/schemas/DegradedStep"},"type":"array"}},"required":["count","recent","outage"],"type":"object"},"DegradedStep":{"additionalProperties":false,"properties":{"cause":{"$ref":"#/components/schemas/SemanticOutageCause"},"step":{"format":"int32","type":"integer"}},"required":["step","cause"],"type":"object"},"DeploymentIdentity":{"description":"`GET /.well-known/aidash`: the Deployment's identity and its Deployment Key.\nIt names no Node; Nodes belong to Tenants and are not public.","properties":{"endpoint":{"type":"string"},"id":{"type":"string"},"key":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}],"description":"Absent when the Deployment has no Deployment Key, so it cannot federate\nwith other Deployments."},"key_rollover":{"anyOf":[{"$ref":"#/components/schemas/DeploymentRolloverIdentity"},{"type":"null"}],"description":"A published normal transition, containing public keys and proof only."},"protocol_version":{"type":"string"}},"required":["id","endpoint","protocol_version","key"],"type":"object"},"DeploymentKeyIdentity":{"properties":{"id":{"description":"The token `kid`, which a Tenant Administrator types to pin this key.","type":"string"},"public_key_pem":{"description":"SubjectPublicKeyInfo PEM of the Ed25519 public key.","type":"string"}},"required":["id","public_key_pem"],"type":"object"},"DeploymentRolloverIdentity":{"properties":{"activates_at":{"format":"uint64","minimum":0,"type":"integer"},"published_at":{"format":"uint64","minimum":0,"type":"integer"},"retires_at":{"format":"uint64","minimum":0,"type":"integer"},"retiring":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}]},"successor":{"anyOf":[{"$ref":"#/components/schemas/DeploymentKeyIdentity"},{"type":"null"}]},"transition":{"type":["string","null"]}},"required":["successor","retiring","published_at","activates_at","retires_at","transition"],"type":"object"},"Entry":{"additionalProperties":false,"properties":{"binding_normalization":{"anyOf":[{"$ref":"#/components/schemas/AgentNormalization"},{"type":"null"}]},"capabilities":{"default":[],"items":{"type":"string"},"type":"array"},"config":{"additionalProperties":true,"default":{},"type":"object"},"description":{"additionalProperties":{"type":"string"},"type":"object"},"id":{"type":"string"},"installation":{"anyOf":[{"$ref":"#/components/schemas/MarketplaceProjection"},{"type":"null"}]},"kind":{"type":"string"},"languages":{"default":[],"items":{"type":"string"},"type":"array"},"name":{"additionalProperties":{"type":"string"},"type":"object"},"schema":{"default":{}},"skills":{"default":[],"items":{"type":"string"},"type":"array"},"tags":{"default":[],"items":{"type":"string"},"type":"array"},"version":{"type":"string"}},"required":["id","version","kind","name","description","capabilities","tags","languages","skills","schema","config"],"type":"object"},"Event":{"properties":{"created_at":{"format":"date-time","type":"string"},"data":{},"id":{"format":"uuid","type":"string"},"kind":{"type":"string"},"node":{"anyOf":[{"$ref":"#/components/schemas/NodeName"},{"type":"null"}],"description":"The Node of the Workspace or executing Run; none for a Tenant-level event."},"sequence":{"format":"int64","type":"integer"},"workspace_id":{"format":"uuid","type":["string","null"]}},"required":["sequence","id","node","workspace_id","kind","data","created_at"],"type":"object"},"FailureTarget":{"enum":["FAILED","CANCELLED"],"type":"string"},"HomeApproval":{"additionalProperties":false,"description":"The answer a Run executing for another Node received from that Node's\nhuman request, for the exact call it was asked about.","properties":{"approved":{"type":"boolean"},"call":{"$ref":"#/components/schemas/ToolCall"},"key":{"type":"string"}},"required":["key","call","approved"],"type":"object"},"HumanRequest":{"properties":{"answer_by":{"description":"When the Run waiting for this question continues without an answer, if\nits person set an Answer Deadline. State and Human Request listings fill\nit from the Run's waiting state.","format":"date-time","type":["string","null"]},"answered_by":{"type":["string","null"]},"created_at":{"format":"date-time","type":"string"},"id":{"format":"uuid","type":"string"},"kind":{"type":"string"},"prompt":{"type":"string"},"response":{},"run_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["answered_by","id","workspace_id","run_id","kind","prompt","response","created_at"],"type":"object"},"InputRequest":{"additionalProperties":false,"properties":{"method":{"type":"string"},"params":{}},"required":["method","params"],"type":"object"},"LeaseWait":{"description":"Why a Run that no worker currently holds is not being claimed.","oneOf":[{"description":"Only a worker that understands these capabilities may claim the Run.","properties":{"capabilities":{"items":{"type":"string"},"type":"array"},"reason":{"enum":["capable_worker"],"type":"string"}},"required":["reason","capabilities"],"type":"object"}]},"MarketplaceProjection":{"additionalProperties":false,"properties":{"contract":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"},"installation":{"type":"string"},"revision":{"format":"int64","type":"integer"},"tenant":{"type":"string"}},"required":["contract","tenant","installation","revision"],"type":"object"},"ModelFileSelection":{"additionalProperties":false,"description":"A one-inference file reference can additionally name a creator-owned Subnode Area.","properties":{"area_id":{"format":"uuid","type":["string","null"]},"expected_digest":{"type":"string"},"file_id":{"format":"uuid","type":"string"},"workspace_id":{"format":"uuid","type":["string","null"]}},"required":["file_id","expected_digest"],"type":"object"},"ModelMedia":{"anyOf":[{"$ref":"#/components/schemas/ModelFileSelection"},{"$ref":"#/components/schemas/WorkingImageSelection"},{"$ref":"#/components/schemas/PageImageSelection"},{"$ref":"#/components/schemas/ThreadAttachmentSelection"}],"description":"One input selected for a model request: a Working Area file, or the page\nimage of one of the Run's Evidence fragments (ADR 0053). A file selection\nkeeps its stored shape."},"ModelResponse":{"additionalProperties":false,"properties":{"input_tokens":{"format":"uint64","minimum":0,"type":"integer"},"output_tokens":{"format":"uint64","minimum":0,"type":"integer"},"provider_activity":{"description":"Observable provider-owned activity, never Research evidence or citations.","items":{},"type":"array"},"text":{"type":"string"},"tool_calls":{"items":{"$ref":"#/components/schemas/ToolCall"},"type":"array"},"usage_complete":{"type":"boolean"}},"required":["text","tool_calls","input_tokens","output_tokens","usage_complete"],"type":"object"},"Narrowing":{"additionalProperties":false,"description":"No effect, replay, approval or disclosure field is accepted here. Concurrency\nsafety may only be lowered; a claim above the provider's is rejected.","properties":{"allowed_hosts":{"items":{"type":"string"},"type":["array","null"],"uniqueItems":true},"concurrency":{"anyOf":[{"$ref":"#/components/schemas/Concurrency"},{"type":"null"}]},"decision":{"anyOf":[{"$ref":"#/components/schemas/Restrictions"},{"type":"null"}]},"limits":{"additionalProperties":{"format":"uint64","minimum":0,"type":"integer"},"type":"object"},"provider_tool":{"anyOf":[{"$ref":"#/components/schemas/Parameters"},{"type":"null"}],"description":"Provider-owned tools take immutable Binding parameters, never model arguments."},"scope":{"additionalProperties":{"items":{"type":"string"},"type":"array","uniqueItems":true},"type":"object"}},"type":"object"},"NextCursors":{"properties":{"artifacts":{"type":["string","null"]},"conversations":{"type":["string","null"]},"human_requests":{"type":["string","null"]},"runs":{"type":["string","null"]},"tasks":{"type":["string","null"]},"workspaces":{"type":["string","null"]}},"required":["workspaces","tasks","runs","artifacts","human_requests","conversations"],"type":"object"},"NodeName":{"description":"The identifier Aidash assigns to a Node, in the same form as a Tenant name:\n`<adjective>-<noun>-<8 random characters>`. Unique within its Deployment,\nnever changed and never reused.","type":"string"},"NormalizedBinding":{"additionalProperties":false,"properties":{"binding":{"$ref":"#/components/schemas/Binding3"},"origin":{"$ref":"#/components/schemas/BindingOrigin"}},"required":["binding","origin"],"type":"object"},"PageImageSelection":{"additionalProperties":false,"description":"The page image of an Evidence fragment, by the digest the model was given.","properties":{"evidence_ref":{"type":"string"},"expected_digest":{"type":"string"}},"required":["evidence_ref","expected_digest"],"type":"object"},"Parameters":{"additionalProperties":false,"description":"Binding-owned configuration, copied into the immutable Binding snapshot.\nNo default is deserialized: an author must explicitly pin every spending cap.","properties":{"max_tool_calls":{"format":"uint32","minimum":0,"type":"integer"},"parameters":{}},"required":["max_tool_calls","parameters"],"type":"object"},"PausedCall":{"additionalProperties":false,"description":"The call an Authority Pause stopped, recorded only when it certainly did not run.","properties":{"index":{"format":"uint","minimum":0,"type":"integer"},"key":{"type":"string"},"kind":{"$ref":"#/components/schemas/RefusalKind"},"replay_safe":{"type":"boolean"},"tool":{"type":"string"}},"required":["key","index","replay_safe","tool","kind"],"type":"object"},"QualifiedRef":{"additionalProperties":false,"properties":{"id":{"type":"string"},"registry_deployment":{"type":"string"},"version":{"type":"string"}},"required":["registry_deployment","id","version"],"type":"object"},"ReadPlan":{"additionalProperties":false,"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"cursor":{"format":"uint","minimum":0,"type":"integer"},"result":{},"step":{"format":"int32","type":"integer"}},"required":["step","cursor","call","result"],"type":"object"},"ReadyState":{"additionalProperties":false,"type":"object"},"RecoveryState":{"additionalProperties":false,"properties":{"connection_refusals":{"description":"Transport-proven, still-unsatisfied refusals. Tool result JSON never populates these.","items":{"$ref":"#/components/schemas/ConnectionRefusal"},"type":"array"},"connection_wait":{"anyOf":[{"$ref":"#/components/schemas/ConnectionWait"},{"type":"null"}]},"connection_waited":{"description":"Survives context compaction and prevents repeated failure deferrals.","items":{"type":"string"},"type":"array","uniqueItems":true},"context_reason":{"anyOf":[{"$ref":"#/components/schemas/ContextRecoveryFailure"},{"type":"null"}],"description":"Typed context-recovery reason for a paused Run; cleared on resume."},"decider_retry":{"description":"Outage retries of the current step's compaction decision after every\nDecider Route failed. A decision commits to it, so each retry asks the\nRoutes again; it is reset once the step saves anything else (ADR 0066).","format":"uint32","minimum":0,"type":"integer"},"decision_cycle":{"description":"How many times a person resumed this Run from a pause. A compaction\ndecision commits to it, so a resume starts a new decision while a\nrecovered lease continues the same one (#108).","format":"uint32","minimum":0,"type":"integer"},"declined_calls":{"description":"Calls a person declined, kept until the worker has answered them. Separate from\n`paused_call`: an earlier sibling of a Tool Batch can pause the Run again first.","items":{"$ref":"#/components/schemas/DeclinedCall"},"type":"array"},"degraded":{"$ref":"#/components/schemas/DegradedContext","description":"Steps that ran with Degraded context (ADR 0059). Kept across resumes."},"lease_recoveries":{"description":"Consecutive Lease Recoveries of the current step.","format":"uint32","minimum":0,"type":"integer"},"node_retry":{"description":"Retries of the current step after another Node did not answer a check\n(#751). A retry asks again, so it is reset once the step saves anything\nelse.","format":"uint32","minimum":0,"type":"integer"},"paused_call":{"anyOf":[{"$ref":"#/components/schemas/PausedCall"},{"type":"null"}],"description":"The tool call an Authority Pause stopped, when a person may decline it (#763). Cleared on\nresume; people never read it, only whether they may decline."},"remote_task_fingerprint":{"description":"Fingerprint of remote terminal child Tasks observed before inference.","type":["string","null"]},"retry":{"anyOf":[{"$ref":"#/components/schemas/RetryState"},{"type":"null"}]},"semantic_reason":{"anyOf":[{"$ref":"#/components/schemas/RemoteSemanticFailure"},{"type":"null"}]},"workspace_event_cursor":{"description":"Last workspace event delivered to this Run.","format":"int64","type":["integer","null"]}},"required":["retry"],"type":"object"},"RefusalKind":{"description":"Which authority refused a call a person could have lifted (#763). A closed set the model is\ntold about, so it names no action, subject or person.","oneOf":[{"description":"The Tenant policy of the Node the Run executes on.","enum":["policy"],"type":"string"},{"description":"Catalog Approval of a Registry entry.","enum":["catalog_approval"],"type":"string"},{"description":"The Agent's own configuration.","enum":["agent_configuration"],"type":"string"},{"description":"The authority of the Node the Run was delegated to.","enum":["other_node"],"type":"string"}]},"RemoteSemanticFailure":{"description":"Public reasons contain no query, source ID, upstream body, or credential.","oneOf":[{"enum":["configuration","authority","invalidated","provider_contract","embedding_model_not_found","context_budget","durable_memory_budget","allowance","unavailable","retries_exhausted","pending"],"type":"string"},{"description":"A reused retrieval no longer matches the Home corpus; the Run retrieves\nit again instead of pausing.","enum":["stale"],"type":"string"}]},"RequiredInput":{"additionalProperties":false,"properties":{"request_state":{"description":"Opaque server data, echoed verbatim; it is never interpreted as authority.","type":["string","null"]},"requests":{"additionalProperties":{"$ref":"#/components/schemas/InputRequest"},"type":"object"}},"required":["request_state","requests"],"type":"object"},"Restrictions":{"additionalProperties":false,"description":"What a Binding may tighten. A lower threshold takes the conservative action\nat a lower probability: it keeps more content for compaction and blocks more\ncalls for approval. `preserve_recent` and `forbid_apply` apply to compaction\nonly; an approval Decider reads `threshold` and `max_calls_per_run`.","properties":{"forbid_apply":{"default":false,"type":"boolean"},"max_calls_per_run":{"description":"A lower per-Run call limit than the Decider version declares.","format":"uint64","minimum":0,"type":["integer","null"]},"preserve_recent":{"default":6,"description":"Events, or on the Native Projection Version Model Turns, never classified.","format":"uint","minimum":0,"type":"integer"},"threshold":{"default":"3fe0000000000000","description":"The probability at which an answer takes the conservative action; lower\nis stricter. A Route's own threshold is intersected in when it is asked.","type":"string"}},"required":["threshold","preserve_recent","forbid_apply","max_calls_per_run"],"type":"object"},"ResumeState":{"oneOf":[{"additionalProperties":false,"properties":{"data":{"$ref":"#/components/schemas/ReadyState"},"phase":{"enum":["READY"],"type":"string"}},"required":["phase","data"],"type":"object"},{"additionalProperties":false,"properties":{"data":{"$ref":"#/components/schemas/ThinkingState"},"phase":{"enum":["THINKING"],"type":"string"}},"required":["phase","data"],"type":"object"},{"additionalProperties":false,"properties":{"data":{"$ref":"#/components/schemas/ToolCallState"},"phase":{"enum":["TOOL_CALL"],"type":"string"}},"required":["phase","data"],"type":"object"}]},"RetryState":{"additionalProperties":false,"properties":{"at":{"format":"date-time","type":"string"},"count":{"format":"uint32","minimum":0,"type":"integer"}},"required":["count","at"],"type":"object"},"RunControl":{"enum":["ACTIVE","PAUSED","CANCELLED"],"type":"string"},"RunPhase":{"enum":["READY","THINKING","TOOL_CALL","WAITING","COMPLETED","FAILED","CANCELLED"],"type":"string"},"RunState":{"oneOf":[{"additionalProperties":false,"properties":{"data":{"$ref":"#/compon