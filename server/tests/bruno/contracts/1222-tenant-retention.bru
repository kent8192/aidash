meta {
  name: 1222 tenant-retention - Application read preserves the typed response contract
  type: http
  seq: 1222
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/retention
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"RetentionRules":{"additionalProperties":false,"description":"The periods of every kind of content Aidash keeps only for a while.","properties":{"document_snapshots":{"$ref":"#/components/schemas/SnapshotPeriods"}},"required":["document_snapshots"],"type":"object"},"SnapshotPeriods":{"additionalProperties":false,"description":"How long the contents of a Document snapshot are kept.","properties":{"after_run_seconds":{"description":"Kept this long after the snapshot's Run ends.","format":"uint32","minimum":0,"type":"integer"},"max_age_seconds":{"description":"Never kept longer than this after retrieval, even while the Run lasts.","format":"uint32","minimum":0,"type":"integer"}},"required":["after_run_seconds","max_age_seconds"],"type":"object"},"TenantRetentionView":{"description":"The Retention Rules that apply to one Tenant, with what the caller may do\nabout them, so a dashboard offers only that.","properties":{"can_read_history":{"description":"Whether the caller may read the history of the Tenant's periods.","type":"boolean"},"can_read_revocations":{"description":"Whether the caller may read the Tenant's Evidence Revocation records.","type":"boolean"},"can_update":{"description":"Whether the caller may change or clear the Tenant's periods.","type":"boolean"},"deployment":{"$ref":"#/components/schemas/RetentionRules","description":"The Deployment's periods, also the longest the Tenant may keep."},"effective":{"$ref":"#/components/schemas/RetentionRules","description":"What applies: the shorter of the two for every period."},"tenant":{"type":"string"},"tenant_rules":{"anyOf":[{"$ref":"#/components/schemas/RetentionRules"},{"type":"null"}],"description":"The Tenant's own shorter periods, if it stores any."}},"required":["tenant","deployment","tenant_rules","effective","can_update","can_read_history","can_read_revocations"],"type":"object"}},"schema":{"$ref":"#/components/schemas/TenantRetentionView"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
