meta {
  name: 1338 authorization-catalog-review - Deployment Administrator bearer has no Tenant authority
  type: http
  seq: 1338
}

get {
  url: {{base_url}}/api/authorization/{{tenant}}/catalog/review?entry=aidash.workspace_read@1.0.0&node=brave-otter-k3m9q2xa
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
