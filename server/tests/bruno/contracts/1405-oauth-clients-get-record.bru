meta {
  name: 1405 oauth-clients-get-record - Anonymous request is rejected
  type: http
  seq: 1405
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/oauth-clients/11111111-1111-4111-8111-111111111111
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
