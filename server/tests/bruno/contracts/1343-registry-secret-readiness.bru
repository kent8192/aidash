meta {
  name: 1343 registry-secret-readiness - Subject without registry.read cannot read Tenant Secret readiness
  type: http
  seq: 1343
}

get {
  url: {{base_url}}/api/registry/__bruno_missing__/__bruno_missing__/secret-readiness
  body: none
