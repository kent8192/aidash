meta {
  name: 1110 tenants-list - Deployment Administrator lists every Tenant root record
  type: http
  seq: 1110
}

get {
  url: {{base_url}}/api/tenants
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"type":"array","items":{"$ref":"#/components/schemas/TenantRecord"}},"definitions":{"PurgeProgress":{"type":"object","description":"A purge that started, for Deployment Administrators (ADR 0061).","required":["step","failures","error","failed_at","stalled"],"properties":{"error":{"type":["string","null"],"description":"Why the step last failed."},"failed_at":{"type":["string","null"],"format":"date-time"},"failures":{"type":"integer","format":"uint32","description":"Consecutive failures of that step.","minimum":0},"stalled":{"type":"boolean","description":"The purge failed several times in a row and needs attention."},"step":{"type":["string","null"],"description":"The step that runs next, or that keeps failing: `provider_credentials`,\n`capability_objects`, `rows` or `finish`."}}},"TenantDeletionView":{"type":"object","description":"A recorded Tenant Deletion.","required":["tenant","deleted_at","deleted_by_kind","purge_after","purged_at"],"properties":{"deleted_at":{"type":"string","format":"date-time"},"deleted_by_kind":{"type":"string","description":"`tenant_administrator` or `deployment_administrator`."},"purge_after":{"type":"string","format":"date-time","description":"The end of the grace period: restoring is possible until then."},"purged_at":{"type":["string","null"],"format":"date-time","description":"When the Tenant's data was purged; it can no longer be restored."},"tenant":{"type":"string"}}},"TenantRecord":{"type":"object","description":"A Tenant's root record as Deployment Administrators see it.","required":["name","label","personal","created_at","created_by_kind","deletion","restorable","purgeable","purge"],"properties":{"created_at":{"type":"string","format":"date-time"},"created_by_kind":{"type":"string","description":"`identity` for a Tenant Creator, `deployment_administrator` for a Deployment Administrator."},"deletion":{"anyOf":[{"$ref":"#/components/schemas/TenantDeletionView"},{"type":"null"}],"description":"The Tenant's current deletion; absent while the Tenant is in use."},"label":{"type":["string","null"]},"name":{"type":"string"},"personal":{"type":"boolean"},"purge":{"anyOf":[{"$ref":"#/components/schemas/PurgeProgress"},{"type":"null"}],"description":"How far the Tenant's purge got, once it started or failed."},"purgeable":{"type":"boolean","description":"Whether a Deployment Administrator may purge the Tenant now: it is\ndeleted and its data is not purged yet."},"restorable":{"type":"boolean","description":"Whether a Deployment Administrator may restore the Tenant now, decided\nby the database clock rather than the reader's."}}}}}; function valid(value,schema){if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop()]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Deployment Administrator lists every Tenant root record contract", function () { expect(res.getBody()).to.be.an("array");expect(res.getBody().map(tenant => tenant.name)).to.include(bru.getEnvVar("tenant")); });
}
