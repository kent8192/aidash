meta {
  name: 1345 approval-observation-report - Forged bearer cannot inspect approval observations
  type: http
  seq: 1345
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/approval-observations/report?start=2026-10-01T00:00:00Z&end=2026-10-02T00:00:00Z
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
