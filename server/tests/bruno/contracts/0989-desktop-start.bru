meta {
  name: 0989 desktop-start - Reject malformed S256 challenge
  type: http
  seq: 989
}

post {
  url: {{base_url}}/auth/desktop/start
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"redirect_uri": "http://127.0.0.1:43217/callback", "state": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss", "code_challenge": "invalid"}
}

tests {
  test("Exact HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |operator_token|peer_token/); });
}
