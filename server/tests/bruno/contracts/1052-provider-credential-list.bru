meta {
  name: 1052 provider-credential-list - Missing Store fails closed for the operator
  type: http
  seq: 1052
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/provider-credentials
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{operator_token}}
}

tests {
  test("Exact HTTP 404", function () { expect(res.getStatus()).to.equal(404); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |operator_token|peer_token/); });
  test("Missing Store fails closed for the operator contract", function () { expect(res.getHeader("cache-control")).to.equal("no-store");expect(res.getBody()).to.eql({error:"Provider Credential Store is not configured"}); });
}
