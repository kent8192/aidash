meta {
  name: 0912 openapi - Untrusted bearer does not restrict public reads
  type: http
  seq: 912
}

get {
  url: {{base_url}}/api/openapi.json
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer invalid
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Untrusted bearer does not restrict public reads contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody()).to.be.an("object");expect(res.getBody().openapi).to.match(/^3\./);expect(res.getBody().paths["/api/workspaces"]).to.have.property("post");expect(JSON.stringify(res.getBody())).not.to.include(bru.getEnvVar("deployment_administrator_token")); });
}
