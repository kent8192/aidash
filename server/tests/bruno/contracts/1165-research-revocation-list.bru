meta {
  name: 1165 research-revocation-list - Application read preserves the typed response contract
  type: http
  seq: 1165
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/research-revocations
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"type":"array","items":{"$ref":"#/components/schemas/RevocationRecord"}},"definitions":{"RevocationRecord":{"type":"object","description":"The audit record of one Evidence Revocation. It holds digests but no\nsource content.","required":["run_id","tenant","revoked_by","reason","revoked_at","removed"],"properties":{"reason":{"type":"string"},"removed":{"$ref":"#/components/schemas/RemovedCopies"},"revoked_at":{"type":"string","format":"date-time"},"revoked_by":{"type":"string","description":"`subject:<tenant>/<subject>`, `deployment-administrator:<identity>` or\n`deployment-administrator` for the deployment's API token."},"run_id":{"type":"string","format":"uuid"},"tenant":{"type":["string","null"],"description":"The Run's Tenant, when it has one."}}},"RemovedCopies":{"type":"object","description":"What a revocation removed, counted and identified by digest only.","required":["sources","snapshots","fragments","attempts","invocations","snapshot_digests"],"properties":{"attempts":{"type":"integer","format":"uint32","minimum":0},"fragments":{"type":"integer","format":"uint32","minimum":0},"invocations":{"type":"integer","format":"uint32","minimum":0},"snapshot_digests":{"type":"array","items":{"type":"string"},"description":"`sha256:` text digests of the revoked Document snapshots."},"snapshots":{"type":"integer","format":"uint32","minimum":0},"sources":{"type":"integer","format":"uint32","minimum":0}}}}}; function valid(value,schema){if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop()]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
