meta {
  name: 1397 tenant-node-deletion - Anonymous Node lifecycle request is rejected
  type: http
  seq: 1397
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/nodes/{{tenant_node}}/deletion
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"confirmation": "{{tenant_node}}"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
