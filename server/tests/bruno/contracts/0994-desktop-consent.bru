meta {
  name: 0994 desktop-consent - Desktop consent requires a browser session
  type: http
  seq: 994
}

post {
  url: {{base_url}}/auth/desktop/authorize
  body: formUrlEncoded
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  request: 11111111-1111-4111-8111-111111111111
  csrf: invalid
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
