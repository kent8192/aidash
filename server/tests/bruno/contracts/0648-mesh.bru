n":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"]}],"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it."},"Restrictions":{"type":"object","description":"Lower keep thresholds and larger protected suffixes preserve more content.","required":["keep_threshold","preserve_recent","forbid_apply","max_calls_per_run"],"properties":{"forbid_apply":{"type":"boolean","default":false},"keep_threshold":{"type":"string","default":"3fe0000000000000"},"max_calls_per_run":{"type":["integer","null"],"format":"uint64","description":"A lower per-Run call limit than the Decider version declares.","minimum":0},"preserve_recent":{"type":"integer","format":"uint","description":"Events, or on the Native Projection Version Model Turns, never classified.","default":6,"minimum":0}},"additionalProperties":false},"BindingOrigin":{"type":"string","description":"Only the registration resolver creates provenance; it is absent from writable Bindings.","enum":["required","default","explicit","skill_support","companion"]},"MarketplaceProjection":{"type":"object","required":["contract","tenant","installation","revision"],"properties":{"contract":{"type":"integer","format":"uint8","maximum":255,"minimum":0},"installation":{"type":"string"},"revision":{"type":"integer","format":"int64"},"tenant":{"type":"string"}},"additionalProperties":false},"ResolvedDefinition":{"type":"object","required":["identity","definition","digest"],"properties":{"definition":{"$ref":"#/components/schemas/Entry"},"digest":{"type":"string"},"identity":{"$ref":"#/components/schemas/QualifiedRef"}},"additionalProperties":false},"ForeignAgentSnapshot":{"type":"object","description":"One authenticated receiver's public closure. Nested foreign or private\ndependencies require their own supported disclosure/admission protocol.","required":["schema_version","agent","bindings","definitions"],"properties":{"agent":{"$ref":"#/components/schemas/QualifiedRef"},"bindings":{"type":"array","items":{"$ref":"#/components/schemas/ResolvedBinding"}},"definitions":{"type":"array","items":{"$ref":"#/components/schemas/ResolvedDefinition"}},"schema_version":{"type":"integer","format":"uint8","maximum":255,"minimum":0}},"additionalProperties":false},"CompletionProgress":{"type":"object","description":"Run-lifetime Completion Gate state, kept with the Run's context and never\nsent to the model.","required":["input_seq","repairs","attempts","seconds","reviews"],"properties":{"attempts":{"type":"integer","format":"uint32","description":"Check attempts started by this Run; numbers each attempt's key.","default":0,"minimum":0},"basis":{"anyOf":[{"$ref":"#/components/schemas/CompletionBasis"},{"type":"null"}],"description":"How the Run's Task was completed, once it was."},"evidence":{"type":"array","items":{"$ref":"#/components/schemas/VerificationEvidence"}},"input_seq":{"type":"integer","format":"int64","description":"The accepted human input the Repair Allowance belongs to.","default":0},"pending":{"anyOf":[{"$ref":"#/components/schemas/PendingCheck"},{"type":"null"}]},"repairs":{"type":"integer","format":"uint32","default":0,"minimum":0},"review":{"type":["string","null"],"format":"uuid","description":"The human request of the Completion Review the Run waits on."},"reviews":{"type":"integer","format":"uint32","description":"Completion Reviews raised by this Run; numbers each review's request key.","default":0,"minimum":0},"seconds":{"type":"integer","format":"uint64","description":"Check time already spent by this Run.","default":0,"minimum":0},"start_content":{"type":["string","null"],"description":"Content digest when the Run first executed; `None` until recorded."}},"additionalProperties":false},"CompletionBasis":{"type":"string","description":"How a Task came to be completed. Only `Verified` means Checks passed.","enum":["verified","not_required","excepted"]},"Verifi