meta {
  name: 0648 mesh - Application read preserves the typed response contract
  type: http
  seq: 648
}

get {
  url: {{base_url}}/api/mesh
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
