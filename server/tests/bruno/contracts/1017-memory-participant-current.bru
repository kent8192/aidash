meta {
  name: 1017 memory-participant-current - Missing scoped authority cannot disclose application data
  type: http
  seq: 1017
}

get {
  url: {{base_url}}/api/workspaces/{{workspace_id}}/tasks/11111111-1111-4111-8111-111111111111/memory-participant
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
