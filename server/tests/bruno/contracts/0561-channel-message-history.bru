meta {
  name: 0561 channel-message-history - Application read preserves the typed response contract
  type: http
  seq: 561
}

get {
  url: {{base_url}}/api/workspaces/{{workspace_id}}/message-history
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"ChannelAttachment":{"properties":{"filename":{"type":"string"},"id":{"format":"uuid","type":"string"},"media_type":{"type":"string"},"size_bytes":{"format":"int64","type":"integer"}},"required":["id","filename","media_type","size_bytes"],"type":"object"},"ChannelCitation":{"description":"A citation as one viewer may see it.\n\n`available` is false when the hold that kept the version is gone; the version\nis never substituted. A viewer who may not download the Working Area sees the\npath and ids only, with `reason = \"forbidden\"` and no digest, size, media type\nor revision.","properties":{"area_id":{"format":"uuid","type":"string"},"available":{"type":"boolean"},"digest":{"type":["string","null"]},"file_id":{"format":"uuid","type":"string"},"media_type":{"type":["string","null"]},"path":{"type":"string"},"reason":{"type":["string","null"]},"revision":{"format":"int64","type":["integer","null"]},"run_id":{"format":"uuid","type":["string","null"]},"size":{"format":"uint64","minimum":0,"type":["integer","null"]}},"required":["area_id","file_id","path","available"],"type":"object"},"ChannelMessage":{"properties":{"attachments":{"items":{"$ref":"#/components/schemas/ChannelAttachment"},"type":"array"},"citations":{"default":[],"items":{"$ref":"#/components/schemas/ChannelCitation"},"type":"array"},"is_thread_root":{"type":"boolean"},"message":{"$ref":"#/components/schemas/Message"},"thread_id":{"format":"uuid","type":["string","null"]}},"required":["message","thread_id","is_thread_root","attachments","citations"],"type":"object"},"ChannelMessagePage":{"properties":{"messages":{"description":"Each page is chronological; next_before retrieves an older page.","items":{"$ref":"#/components/schemas/ChannelMessage"},"type":"array"},"next_before":{"format":"uuid","type":["string","null"]}},"required":["messages","next_before"],"type":"object"},"Message":{"properties":{"content":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"id":{"format":"uuid","type":"string"},"idempotency_key":{"type":["string","null"]},"run_id":{"description":"The Run that published this message on this Node. Only the Run's own\npublication writes it; messages that people or other Nodes deliver have\nnone. Source citations in its content resolve only against this Run.","format":"uuid","type":["string","null"]},"sender":{"type":"string"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","workspace_id","sender","content","idempotency_key","created_at"],"type":"object"}},"schema":{"$ref":"#/components/schemas/ChannelMessagePage"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody().messages).to.be.an("array"); });
}
