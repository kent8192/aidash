meta {
  name: 0981 frontend-index - Serve the configured frontend content
  type: http
  seq: 981
}

get {
  url: {{base_url}}/
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Serve the configured frontend content contract", function () { expect(res.getBody()).to.include("Bruno frontend fixture");expect(res.getHeader("x-content-type-options")).to.equal("nosniff");bru.setVar("frontendEtag",res.getHeader("etag")); });
}
