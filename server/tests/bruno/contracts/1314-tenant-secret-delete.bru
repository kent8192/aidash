meta {
  name: 1314 tenant-secret-delete - Forged bearer cannot manage Tenant Secrets
  type: http
  seq: 1314
}

delete {
  url: {{base_url}}/api/tenants/{{tenant}}/secrets/__bruno_missing__
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"expected_revision": 0}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
