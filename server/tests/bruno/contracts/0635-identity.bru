meta {
  name: 0635 identity - Foreign origin receives the same public contract
  type: http
  seq: 635
}

get {
  url: {{base_url}}/.well-known/aidash
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: https://untrusted.example
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Foreign origin receives the same public contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody()).to.be.an("object");expect(res.getBody().id).to.equal(bru.getEnvVar("node_id"));expect(res.getBody().protocol_version).to.equal("0.1"); });
}
