meta {
  name: 1070 tenant-registrations - Paging rejects nonnumeric offsets
  type: http
  seq: 1070
}

get {
  url: {{base_url}}/api/tenants/{{tenant}}/registrations?offset=invalid
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 400", function () { expect(res.getStatus()).to.equal(400); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |deployment_administrator_token|peer_token/); });
}
