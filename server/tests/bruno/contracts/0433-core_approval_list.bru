meta {
  name: 0433 core_approval_list - Application read preserves the typed response contract
  type: http
  seq: 433
}

get {
  url: {{base_url}}/api/capabilities/approvals
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"$ref":"#/components/schemas/ApprovalPage"},"definitions":{"ApprovalCard":{"type":"object","required":["id","kind","run_id","area_id","state","revision","requester","approver","targets","action","expires_at","grant_id","viewer_is_approver","agent_id","agent_version","decided_by","decided_at","allow_always"],"properties":{"action":{"type":"string"},"agent_id":{"type":["string","null"]},"agent_version":{"type":["string","null"]},"allow_always":{"type":"boolean","description":"Whether the reader may choose \"Always allow\": they are the person the\nRun's delegation chain starts at, the approval is still pending and its\nkind can have a rule."},"approver":{"type":["string","null"]},"area_id":{"type":["string","null"],"format":"uuid"},"call":{"description":"For a Tool call approval, the exact call the approver is asked to allow."},"closed_reason":{"type":["string","null"],"description":"Why a `closed` approval or Run grant was closed, such as\n`evidence_revoked` or `run_ended`."},"decided_at":{"type":["string","null"],"format":"date-time"},"decided_by":{"type":["string","null"]},"disclosure":{"type":["string","null"],"description":"For a Web disclosure approval, the exact query or page address that\nwould leave the Node."},"estimated_micro_usd":{"type":["integer","null"],"format":"int64","description":"The price of this one request, recorded when approval was requested\nand charged to the Research account holder: an estimate, not an\ninvoice. Absent for a provider without a price. The account itself is\nkept with the approval for audit and never shown."},"expires_at":{"type":["string","null"],"format":"date-time"},"given_by":{"description":"What gave the approval in advance, under its owner's name: `{\"rule\": id}`\nfor one of their Approval Rules, `{\"mode\": \"bypass\"}` for the Bypass\nmode, `{\"mode\": \"auto\", \"decision\": id}` for the approval Decider and its\nDecision Evidence, and none when a person decided it."},"grant_id":{"type":["string","null"],"format":"uuid"},"id":{"type":"string","format":"uuid"},"kind":{"type":"string","description":"`outbound` (an outbound read), `disclosure` (a Web disclosure),\n`tool_call` (a call of a Tenant's tool) or `grant` (a Run grant)."},"operation":{"type":["string","null"],"description":"The research operation of a Web disclosure approval, or of the\napproval a Web disclosure Run grant came from; for a Tool call\napproval, the operation of the tool the call invokes."},"plugin_tool":{"anyOf":[{"$ref":"#/components/schemas/PluginToolCard"},{"type":"null"}],"description":"For a Tool call approval of a tool a Run pinned from an Agent Plugin, or a Run grant\nfrom one, the plugin, server and tool, and the plugin copy that declared them. `tool` and\n`version` then hold the tool's path and the copy's digest."},"provider":{"type":["string","null"]},"query":{"description":"The validated search query in provider-independent form."},"refused_by":{"description":"What refused the approval in advance, with no one asked: `{\"rule\": id}`\nfor one of the owner's Approval Rules, `{\"mode\": \"dont_ask\"}` for the\nDon't ask mode, and `{\"mode\": \"auto\", \"reason\": ...}` for the approval\nDecider, whose reason names a block category or `unavailable`. None when\na person decided it or it is still open."},"requester":{"type":"string"},"revision":{"type":"integer","format":"int64"},"run_id":{"type":"string","format":"uuid"},"sampling":{"anyOf":[{"$ref":"#/components/schemas/SamplingRequest"},{"type":"null"}]},"sampling_target":{"anyOf":[{"$ref":"#/components/schemas/SamplingTarget"},{"type":"null"}]},"state":{"type":"string"},"targets":{"type":"array","items":{"type":"string"}},"tool":{"type":["string","null"],"description":"For a Tool call approval, or a Run grant from one, the Tenant's tool and\nits definition version."},"version":{"type":["string","null"]},"viewer_is_approver":{"type":"boolean","description":"Whether the reader is the approver this card is addressed to."}}},"ApprovalPage":{"type":"object","required":["items","next_cursor"],"properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/ApprovalCard"}},"next_cursor":{"type":["string","null"],"format":"uuid"}}},"PluginName":{"type":"string","description":"A plugin name: 1-64 characters of `a-z0-9.-`, starting and ending alphanumeric, with neither\n`--` nor `..`."},"PluginToolCard":{"type":"object","description":"The Agent Plugin tool a Tool call approval is asked for.","required":["plugin","server","tool","digest"],"properties":{"digest":{"type":"string","description":"The digest of the plugin copy the Agent version pins."},"plugin":{"type":"string"},"server":{"type":"string"},"tool":{"type":"string","description":"The server's own name for the tool."}}},"SamplingMessage":{"type":"object","required":["role","text"],"properties":{"role":{"type":"string"},"text":{"type":"string"}}},"SamplingRequest":{"type":"object","description":"Only text sampling is accepted; no roots, tools, context inclusion or model\npreferences can enlarge the Run's authority.","required":["messages","system_prompt","max_tokens"],"properties":{"max_tokens":{"type":"integer","format":"uint32","minimum":0},"messages":{"type":"array","items":{"$ref":"#/components/schemas/SamplingMessage"}},"system_prompt":{"type":"string"}}},"SamplingTarget":{"type":"object","required":["agent","plugin","server","digest","origin"],"properties":{"agent":{"type":"string"},"digest":{"type":"string"},"origin":{"type":"string"},"plugin":{"$ref":"#/components/schemas/PluginName"},"server":{"$ref":"#/components/schemas/ServerName"}},"additionalProperties":false},"ServerName":{"type":"string","description":"Aidash's name for a server: 1-64 characters of `A-Za-z0-9_.-`."}}}; function valid(value,schema){if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop()]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody().items).to.be.an("array");expect(res.getBody().next_cursor).to.equal(null); });
}
