meta {
  name: 1197 plan-authorization-start - Forged bearer cannot reach a Plan Connection
  type: http
  seq: 1197
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/plan-connections/chatgpt/authorizations
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
