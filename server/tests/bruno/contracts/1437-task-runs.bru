The Completion Gate refused a final answer because a Check did not pass\non the current files. Each one spends the Repair Allowance of the input\nat `through_seq`.","required":["kind","checks","instruction","through_seq"],"properties":{"checks":{"type":"array","items":{"$ref":"#/components/schemas/RepairNote"}},"instruction":{"type":"string"},"kind":{"type":"string","enum":["completion_repair_required"]},"through_seq":{"type":"integer","format":"int64"}},"additionalProperties":false}]},"ContextRecoveryFailure":{"type":"string","description":"Why a Run paused instead of sending or acting on a provider request.\nEach reason is final for its step; none of them is retried as transport.","enum":["source_selection_unavailable","source_selection_forbidden","source_selection_unapproved","source_selection_calls_exhausted","context_unreducible","decider_unapproved","decider_calls_exhausted","decider_unavailable","summary_unavailable","summary_invalid","overflow_retries_exhausted","output_truncated","refused"]},"ContextUsage":{"type":"object","required":["input_tokens","output_tokens","context_window","compactions"],"properties":{"compactions":{"type":"integer","format":"uint32","minimum":0},"context_window":{"type":"integer","format":"uint","minimum":0},"exposure":{"anyOf":[{"$ref":"#/components/schemas/ExposureUsage"},{"type":"null"}],"description":"Exposure accounting of a `deferred@1` request."},"input_tokens":{"type":"integer","format":"uint64","minimum":0},"output_tokens":{"type":"integer","format":"uint64","minimum":0}},"additionalProperties":false},"ControlSource":{"oneOf":[{"type":"string","description":"A Tenant Subject, or the Run's creation.","enum":["tenant"]},{"type":"string","description":"A Deployment Administrator's Safety Stop.","enum":["deployment_administrator"]},{"type":"string","description":"Aidash itself, such as the pause for an identity status outage.","enum":["system"]}],"description":"The kind of actor that last changed a Run's control. It is shown to anyone\nwho can see the Run; the person and the reason are not."},"DeferredRead":{"type":"object","required":["message","call"],"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"message":{"type":"string"}},"additionalProperties":false},"DegradedContext":{"type":"object","description":"What a Run remembers about its Degraded context.","required":["count","recent","outage"],"properties":{"count":{"type":"integer","format":"uint32","description":"Every step that ran with Degraded context.","minimum":0},"outage":{"type":"boolean","description":"Set by a degraded step and cleared by a retrieval that succeeds. While\nit is set a step tries once and degrades at once if that try fails,\ninstead of waiting for the bounded retry again."},"recent":{"type":"array","items":{"$ref":"#/components/schemas/DegradedStep"},"description":"The latest of those steps, oldest first."}},"additionalProperties":false},"DegradedStep":{"type":"object","required":["step","cause"],"properties":{"cause":{"$ref":"#/components/schemas/SemanticOutageCause"},"step":{"type":"integer","format":"int32"}},"additionalProperties":false},"EntityRef":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string"},"version":{"type":"string"}}},"Entry":{"type":"object","required":["id","version","kind","name","description","capabilities","tags","languages","skills","schema","config"],"properties":{"binding_normalization":{"anyOf":[{"$ref":"#/components/schemas/AgentNormalization"},{"type":"null"}]},"capabilities":{"type":"array","items":{"type":"string"},"default":[]},"config":{"type":"object","default":{},"additionalProperties":true},"description":{"type":"object","additionalProperties":{"type":"string"}},"id":{"type":"string"},"installation":{"anyOf":[{"$ref":"#/components/schemas/MarketplaceProjection"},{"type":"null"}]},"kind":{"type":"string"},"languages":{"type":"array","items":{"type":"string"},"default":[]},"name":{"type":"object","additionalProperties":{"type":"string"