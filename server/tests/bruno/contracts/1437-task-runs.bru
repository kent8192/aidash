meta {
  name: 1437 task-runs - Subject lists the readable Task's Runs
  type: http
  seq: 1437
}

get {
  url: {{base_url}}/api/tasks/{{task_id}}/runs
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"schema":{"$ref":"#/components/schemas/RunPage"},"definitions":{"ActiveInput":{"type":"object","required":["id","started_at","deadline"],"properties":{"deadline":{"type":"string","format":"date-time"},"id":{"type":"string"},"started_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"AgentNormalization":{"type":"object","description":"Read-only registration metadata is compiled by the Node before publication.","required":["schema_version","registry_deployment","compaction_override","bindings"],"properties":{"bindings":{"type":"array","items":{"$ref":"#/components/schemas/NormalizedBinding"}},"compaction_override":{"anyOf":[{"$ref":"#/components/schemas/QualifiedRef"},{"type":"null"}],"description":"Exact explicit compaction replacement, resolved by trusted registration."},"registry_deployment":{"type":"string"},"schema_version":{"type":"integer","format":"uint8","maximum":255,"minimum":0}},"additionalProperties":false},"ApprovalRef":{"oneOf":[{"type":"object","description":"A capability approval record on this Node (tool call, outbound, Web disclosure).","required":["source","approval_id"],"properties":{"approval_id":{"type":"string","format":"uuid"},"source":{"type":"string","enum":["capability"]}},"additionalProperties":false},{"type":"object","description":"A Run executing for another Node asks that Node through a human request.","required":["source","request_id","key","call","expires_at"],"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"expires_at":{"type":"string","format":"date-time"},"key":{"type":"string"},"request_id":{"type":"string","format":"uuid"},"source":{"type":"string","enum":["home"]}},"additionalProperties":false}],"description":"Where the approval a Run waits for is decided."},"ArtifactRef":{"type":"object","required":["reference","revision"],"properties":{"reference":{"type":"string","description":"Path, artifact ID or record referen