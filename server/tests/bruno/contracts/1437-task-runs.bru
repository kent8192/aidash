losure."},"remote":{"type":"boolean","description":"Admission placement determines which implicit defaults must remain excluded."},"schema_version":{"type":"integer","format":"uint8","maximum":255,"minimum":0}},"additionalProperties":false},"CallCheckpoint":{"type":"object","description":"Pinned to the logical call at the ToolCallState cursor. A completed wire\nrequest is journaled before this checkpoint advances, so a lost worker never\nresends an uncertain continuation.","required":["key","continuation_sends","wire_pending","input","responses","active","waited_millis"],"properties":{"active":{"anyOf":[{"$ref":"#/components/schemas/ActiveInput"},{"type":"null"}]},"continuation_sends":{"type":"integer","format":"uint32","minimum":0},"input":{"anyOf":[{"$ref":"#/components/schemas/RequiredInput"},{"type":"null"}]},"key":{"type":"string"},"responses":{"type":"object","additionalProperties":true},"sent":{"anyOf":[{"$ref":"#/components/schemas/SentRound"},{"type":"null"}],"description":"Exact journal identity of the admitted send. Live callbacks own `input`\nand `responses` while waiting, but must never replace this identity."},"waited_millis":{"type":"integer","format":"uint64","minimum":0},"wire_pending":{"type":"boolean"}},"additionalProperties":false},"CapabilityIdentity":{"oneOf":[{"type":"object","required":["registry"],"properties":{"registry":{"$ref":"#/components/schemas/QualifiedRef"}},"additionalProperties":false},{"type":"object","required":["direct_skill"],"properties":{"direct_skill":{"type":"object","required":["skill_id","origin"],"properties":{"origin":{"type":"string"},"skill_id":{"type":"string","format":"uuid"}},"additionalProperties":false}},"additionalProperties":false},{"type":"object","description":"A tool of a remote MCP server that the Run pinned from an Agent Plugin.","required":["agent_plugin_tool"],"properties":{"agent_plugin_tool":{"type":"object","required":["plugin","server","tool"],"properties":{"plugin":{"$ref":"#/components/schemas/PluginName"},"server":{"$ref":"#/components/schemas/ServerName"},"tool":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false}]},"CapabilityKind":{"type":"string","enum":["tool","skill"]},"CheckOutcome":{"oneOf":[{"type":"string","enum":["passed"]},{"type":"string","description":"The Check ran and did not pass.","enum":["failed"]},{"type":"string","description":"The Check ran past its timeout.","enum":["timed_out"]},{"type":"string","description":"The Check could not run, or its result is unknown.","enum":["unavailable"]},{"type":"string","description":"Authority or an approval refused the Check.","enum":["denied"]}]},"CheckSubject":{"type":"object","description":"What one Check invocation tested. Evidence counts only for an identical subject.","required":["check","check_digest","capability_digest","content_digest"],"properties":{"capability_digest":{"type":"string","description":"Digest of the bound capability definition that ran it."},"check":{"type":"string"},"check_digest":{"type":"string","description":"[`Check::digest`] of the definition that ran."},"content_digest":{"type":"string","description":"[`content_digest`] of the files the Check saw."}},"additionalProperties":false},"CompletionBasis":{"type":"string","description":"How a Task came to be completed. Only `Verified` means Checks passed.","enum":["verified","not_required","excepted"]},"CompletionProgress":{"type":"object","description":"Run-lifetime Completion Gate state, kept with the Run's context and never\nsent to the model.","required":["input_seq","repairs","attempts","seconds","reviews"],"properties":{"attempts":{"type":"integer","format":"uint32","description":"Check attempts started by this Run; numbers each attempt's key.","default":0,"minimum":0},"basis":{"anyOf":[{"$ref":"#/components/schemas/CompletionBasis"},{"type":"null"}],"description":"How the Run's Task was completed, once it was."},"evidence":{"type":"array","items":{"$ref":"#/components/schemas/VerificationEvidence"}},"input_seq":{"type":"integer","format":"int64","description":"The accepted human input the Repair Allowance belongs to.","default":0},"pending":{"anyOf":[{"$ref":"#/components/schemas/PendingCheck"},{"type":"null"}]},"repairs":{"type":"integer","format":"uint32","default":0,"minimum":0},"review":{"type":["string","null"],"format":"uuid","description":"The human request of the Completion Review the Run waits on."},"reviews":{"type":"integer","format":"uint32","description":"Completion Reviews raised by this Run; numbers each review's request key.","default":0,"minimum":0},"seconds":{"type":"integer","format":"uint64","description":"Check time already spent by this Run.","default":0,"minimum":0},"start_content":{"type":["string","null"],"description":"Content digest when the Run first executed; `None` until recorded."}},"additionalProperties":false},"Component":{"oneOf":[{"type":"string","enum":["manifest","mcp"]},{"type":"object","required":["skill"],"properties":{"skill":{"type":"string"}},"additionalProperties":false},{"type":"object","required":["server"],"properties":{"server":{"type":"string"}},"additionalProperties":false}]},"Concurrency":{"oneOf":[{"type":"string","description":"Every call runs alone, in the model's order.","enum":["sequential"]},{"type":"string","description":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"]}],"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it."},"ContextEvent":{"oneOf":[{"type":"object","required":["kind","call","result"],"properties":{"call":{"$ref":"#/components/schemas/ToolCall"},"kind":{"type":"string","enum":["tool"]},"result":{}},"additionalProperties":false},{"type":"object","required":["kind","request","request_kind","response"],"properties":{"kind":{"type":"string","enum":["human"]},"request":{"type":"string"},"request_kind":{"type":"string"},"response":{}},"additionalP