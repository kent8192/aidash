meta {
  name: 0267 admissions-verify - Unknown admission cannot supply receiving authority
  type: http
  seq: 267
}

post {
  url: {{base_url}}/federation/v0.1/scoped/execution/admissions/11111111-1111-4111-8111-111111111111/verify
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{peer_token}}
  X-Aidash-Node: {{peer_node}}
  X-Aidash-Protocol: 0.2
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
