meta {
  name: 0991 desktop-authorize - Unknown handoff does not reveal consent
  type: http
  seq: 991
}

get {
  url: {{base_url}}/auth/desktop/authorize?request=11111111-1111-4111-8111-111111111111
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
