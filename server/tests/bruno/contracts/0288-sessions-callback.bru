meta {
  name: 0288 sessions-callback - Tampered login cookie cannot bind the callback
  type: http
  seq: 288
}

get {
  url: {{base_url}}/auth/callback?state=invalid&code=invalid
  body: none
  auth: none
}

headers {
  Accept: application/json
  Cookie: aidash-login=tampered
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
