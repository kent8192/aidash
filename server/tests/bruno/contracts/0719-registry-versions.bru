meta {
  name: 0719 registry-versions - Subject without registry.read cannot list the versions
  type: http
  seq: 719
}

get {
  url: {{base_url}}/api/registry/versions
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{denied_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
