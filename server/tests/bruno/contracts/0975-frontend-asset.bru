meta {
  name: 0975 frontend-asset - Stale conditional request serves current content
  type: http
  seq: 975
}

get {
  url: {{base_url}}/assets/probe.txt
  body: none
  auth: none
}

headers {
  Accept: application/json
  If-None-Match: "stale"
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Stale conditional request serves current content contract", function () { expect(res.getBody()).to.equal("bruno-asset\n"); });
}
