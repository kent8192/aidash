meta {
  name: 1104 tenants-list - Deployment Administrator lists every Tenant root record
  type: http
  seq: 1104
}

get {
  url: {{base_url}}/api/tenants
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"PurgeProgress":{"description":"A purge that started, for Deployment Administrators (ADR 0061).","properties":{"error":{"description":"Why the step last failed.","type":["string","null"]},"failed_at":{"format":"date-time","type":["string","null"]},"failures":{"description":"Consecutive failures of that step.","format":"uint32","minimum":0,"type":"integer"},"stalled":{"description":"The purge failed several times in a row and needs attention.","type":"boolean"},"step":{"description":"The step that runs next, or that keeps failing: `provider_credentials`,\n`capability_objects`, `rows` or `finish`.","type":["string","null"]}},"required":["step","failures","error","failed_at","stalled"],"type":"object"},"TenantDeletionView":{"description":"A recorded Tenant Deletion.","properties":{"deleted_at":{"format":"date-time","type":"string"},"deleted_by_kind":{"description":"`tenant_administrator` or `deployment_administrator`.","type":"string"},"purge_after":{"description":"The end of the grace period: restoring is possible until then.","format":"date-time","type":"string"},"purged_at":{"description":"When the Tenant's data was purged; it can no longer be restored.","format":"date-time","type":["string","null"]},"tenant":{"type":"string"}},"required":["tenant","deleted_at","deleted_by_kind","purge_after","purged_at"],"type":"object"},"TenantRecord":{"description":"A Tenant's root record as Deployment Administrators see it.","properties":{"created_at":{"format":"date-time","type":"string"},"created_by_kind":{"description":"`identity` for a Tenant Creator, `deployment_administrator` for a Deployment Administrator.","type":"string"},"deletion":{"anyOf":[{"$ref":"#/components/schemas/TenantDeletionView"},{"type":"null"}],"description":"The Tenant's current deletion; absent while the Tenant is in use."},"label":{"type":["string","null"]},"name":{"type":"string"},"personal":{"type":"boolean"},"purge":{"anyOf":[{"$ref":"#/components/schemas/PurgeProgress"},{"type":"null"}],"description":"How far the Tenant's purge got, once it started or failed."},"purgeable":{"description":"Whether a Deployment Administrator may purge the Tenant now: it is\ndeleted and its data is not purged yet.","type":"boolean"},"restorable":{"description":"Whether a Deployment Administrator may restore the Tenant now, decided\nby the database clock rather than the reader's.","type":"boolean"}},"required":["name","label","personal","created_at","created_by_kind","deletion","restorable","purgeable","purge"],"type":"object"}},"schema":{"items":{"$ref":"#/components/schemas/TenantRecord"},"type":"array"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Deployment Administrator lists every Tenant root record contract", function () { expect(res.getBody()).to.be.an("array");expect(res.getBody().map(tenant => tenant.name)).to.include(bru.getEnvVar("tenant")); });
}
