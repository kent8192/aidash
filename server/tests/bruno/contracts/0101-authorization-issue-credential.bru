meta {
  name: 0101 authorization-issue-credential - Deployment Administrator cannot issue a fresh subject credential
  type: http
  seq: 35
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}/credentials
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
  Content-Type: application/json
}

body:text {
  {"subject":"alice","expires_in_seconds":3600}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
  test("Deployment Administrator cannot issue a fresh subject credential contract", function () { bru.setVar("contract_token",bru.getEnvVar("contract_alice_token")); });
}
