meta {
  name: 0440 core_approval_list - Application read preserves the typed response contract
  type: http
  seq: 440
}

get {
  url: {{base_url}}/api/capabilities/approvals
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"ApprovalCard":{"properties":{"action":{"type":"string"},"agent_id":{"type":["string","null"]},"agent_version":{"type":["string","null"]},"allow_always":{"description":"Whether the reader may choose \"Always allow\": they are the person the\nRun's delegation chain starts at, the approval is still pending and its\nkind can have a rule.","type":"boolean"},"approver":{"type":["string","null"]},"area_id":{"format":"uuid","type":["string","null"]},"call":{"description":"For a Tool call approval, the exact call the approver is asked to allow."},"closed_reason":{"description":"Why a `closed` approval or Run grant was closed, such as\n`evidence_revoked` or `run_ended`.","type":["string","null"]},"decided_at":{"format":"date-time","type":["string","null"]},"decided_by":{"type":["string","null"]},"disclosure":{"description":"For a Web disclosure approval, the exact query or page address that\nwould leave the Node.","type":["string","null"]},"estimated_micro_usd":{"description":"The price of this one request, recorded when approval was requested\nand charged to the Research account holder: an estimate, not an\ninvoice. Absent for a provider without a price. The account itself is\nkept with the approval for audit and never shown.","format":"int64","type":["integer","null"]},"expires_at":{"format":"date-time","type":["string","null"]},"given_by":{"description":"What gave the approval in advance, under its owner's name: `{\"rule\": id}`\nfor one of their Approval Rules, `{\"mode\": \"bypass\"}` for the Bypass\nmode, `{\"mode\": \"auto\", \"decision\": id}` for the approval Decider and its\nDecision Evidence, and none when a person decided it."},"grant_id":{"format":"uuid","type":["string","null"]},"id":{"format":"uuid","type":"string"},"kind":{"description":"`outbound` (an outbound read), `disclosure` (a Web disclosure),\n`tool_call` (a call of a Tenant's tool) or `grant` (a Run grant).","type":"string"},"operation":{"description":"The research operation of a Web disclosure approval, or of the\napproval a Web disclosure Run grant came from; for a Tool call\napproval, the operation of the tool the call invokes.","type":["string","null"]},"provider":{"type":["string","null"]},"query":{"description":"The validated search query in provider-independent form."},"refused_by":{"description":"What refused the approval in advance, with no one asked: `{\"rule\": id}`\nfor one of the owner's Approval Rules, `{\"mode\": \"dont_ask\"}` for the\nDon't ask mode, and `{\"mode\": \"auto\", \"reason\": ...}` for the approval\nDecider, whose reason names a block category or `unavailable`. None when\na person decided it or it is still open."},"requester":{"type":"string"},"revision":{"format":"int64","type":"integer"},"run_id":{"format":"uuid","type":"string"},"state":{"type":"string"},"targets":{"items":{"type":"string"},"type":"array"},"tool":{"description":"For a Tool call approval, or a Run grant from one, the Tenant's tool and\nits definition version.","type":["string","null"]},"version":{"type":["string","null"]},"viewer_is_approver":{"description":"Whether the reader is the approver this card is addressed to.","type":"boolean"}},"required":["id","kind","run_id","area_id","state","revision","requester","approver","targets","action","expires_at","grant_id","viewer_is_approver","agent_id","agent_version","decided_by","decided_at","allow_always"],"type":"object"},"ApprovalPage":{"properties":{"items":{"items":{"$ref":"#/components/schemas/ApprovalCard"},"type":"array"},"next_cursor":{"format":"uuid","type":["string","null"]}},"required":["items","next_cursor"],"type":"object"}},"schema":{"$ref":"#/components/schemas/ApprovalPage"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody().items).to.be.an("array");expect(res.getBody().next_cursor).to.equal(null); });
}
