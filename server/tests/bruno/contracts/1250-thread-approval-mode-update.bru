meta {
  name: 1250 thread-approval-mode-update - Forged bearer cannot reach a person's approval settings
  type: http
  seq: 1250
}

put {
  url: {{base_url}}/api/workspaces/11111111-1111-4111-8111-111111111111/threads/11111111-1111-4111-8111-111111111111/approval-mode
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"mode": null}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
