meta {
  name: 1095 sessions-login-discovery - OIDC deployment refuses foreign-origin discovery
  type: http
  seq: 1095
}

post {
  url: {{base_url}}/auth/login
  body: formUrlEncoded
  auth: none
}

headers {
  Accept: application/json
  Origin: https://untrusted.example
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  email: alice@acme.example
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
  test("OIDC deployment refuses foreign-origin discovery contract", function () { expect(res.getHeader("set-cookie")).to.equal(undefined); });
}
