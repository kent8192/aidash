meta {
  name: 0605 generation-policies - Application read preserves the typed response contract
  type: http
  seq: 605
}

get {
  url: {{base_url}}/api/generation/{{tenant}}/policies
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
