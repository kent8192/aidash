:{"items":{"$ref":"#/components/schemas/RemoteSemanticProvider"},"type":"array"},"memory":{"description":"Home-owned native memory model roles. The ancestor's total token budget\nand the pinned memory workflow's call/token/cost caps both apply.","items":{"$ref":"#/components/schemas/RemoteSemanticProvider"},"type":"array"},"summary":{"anyOf":[{"$ref":"#/components/schemas/GenerationRemoteAllowance"},{"type":"null"}],"description":"Summary Stage model the remote origin approves for generated Agents."}},"type":"object"},"GenerationSpec":{"additionalProperties":false,"properties":{"approval_required":{"type":"boolean"},"compaction":{"anyOf":[{"$ref":"#/components/schemas/GenerationCompaction"},{"type":"null"}]},"embedding":{"anyOf":[{"$ref":"#/components/schemas/GenerationEmbedding"},{"type":"null"}]},"enabled":{"type":"boolean"},"limits":{"$ref":"#/components/schemas/GenerationLimits"},"permissions":{"$ref":"#/components/schemas/GenerationPermissions"},"remote":{"anyOf":[{"$ref":"#/components/schemas/GenerationRemoteApprovals"},{"type":"null"}]},"summary":{"anyOf":[{"$ref":"#/components/schemas/GenerationSummary"},{"type":"null"}]},"template":{"$ref":"#/components/schemas/Entry"}},"required":["enabled","template","permissions","limits","approval_required"],"type":"object"},"GenerationSummary":{"additionalProperties":false,"description":"Separately approved Summary Stage model for generated Agents. Every\nancestor must approve the same exact model version.","properties":{"call_budget":{"format":"int64","type":"integer"},"calls_per_agent":{"format":"int64","type":"integer"},"provider":{"$ref":"#/components/schemas/EntityRef"}},"required":["provider","calls_per_agent","call_budget"],"type":"object"},"MarketplaceProjection":{"additionalProperties":false,"properties":{"contract":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"},"installation":{"type":"string"},"revision":{"format":"int64","type":"integer"},"tenant":{"type":"string"}},"required":["contract","tenant","installation","revision"],"type":"object"},"Narrowing":{"additionalProperties":false,"description":"No effect, replay, approval or disclosure field is accepted here. Concurrency\nsafety may only be lowered; a claim above the provider's is rejected.","properties":{"allowed_hosts":{"items":{"type":"string"},"type":["array","null"],"uniqueItems":true},"concurrency":{"anyOf":[{"$ref":"#/components/schemas/Concurrency"},{"type":"null"}]},"decision":{"anyOf":[{"$ref":"#/components/schemas/Restrictions"},{"type":"null"}]},"limits":{"additionalProperties":{"format":"uint64","minimum":0,"type":"integer"},"type":"object"},"scope":{"additionalProperties":{"items":{"type":"string"},"type":"array","uniqueItems":true},"type":"object"}},"type":"object"},"NormalizedBinding":{"additionalProperties":false,"properties":{"binding":{"$ref":"#/components/schemas/Binding3"},"origin":{"$ref":"#/components/schemas/BindingOrigin"}},"required":["binding","origin"],"type":"object"},"QualifiedRef":{"additionalProperties":false,"properties":{"id":{"type":"string"},"registry_deployment":{"type":"string"},"version":{"type":"string"}},"required":["registry_deployment","id","version"],"type":"object"},"RemoteSemanticProvider":{"additionalProperties":false,"description":"The configuration digest includes the credential *reference*, never its value.\nOnly the owning node resolves that reference and executes the provider.","properties":{"configuration_digest":{"type":"string"},"digest":{"type":"string"},"entry":{"$ref":"#/components/schemas/EntityRef"},"node_id":{"type":"string"}},"required":["node_id","entry","digest","configuration_digest"],"type":"object"},"Restrictions":{"additionalProperties":false,"description":"What a Binding may tighten. A lower threshold takes the conservative action\nat a lower probability: it keeps more content for compaction and blocks more\ncalls for approval. `preserve_recent` and `forbid_apply` apply to compaction\nonly; an approval Decider reads `threshold` and `max_calls_per_run`.","properties":{"forbid_apply":{"default":false,"type":"boolean"},"max_calls_per_run":{"description":"A lower per-Run call limit than the Decider version declares.","format":"uint64","minimum":0,"type":["integer","null"]},"preserve_recent":{"default":6,"description":"Events, or on the Native Projection Version Model Turns, never classified.","format":"uint","minimum":0,"type":"integer"},"threshold":{"default":"3fe0000000000000","description":"The probability at which an answer takes the conservative action; lower\nis stricter. A Route's own threshold is intersected in when it is asked.","type":"string"}},"required":["threshold","preserve_recent","forbid_apply","max_calls_per_run"],"type":"object"}},"schema":{"items":{"$ref":"#/components/schemas/GenerationPolicy"},"type":"array"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
