meta {
  name: 0163 remote_execution_list - Missing scoped authority cannot disclose application data
  type: http
  seq: 163
}

get {
  url: {{base_url}}/api/tasks/11111111-1111-4111-8111-111111111111/remote-executions
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{operator_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
