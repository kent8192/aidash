meta {
  name: 1336 marketplace-secret-readiness - Subject without registry.read cannot read Tenant Secret readiness
  type: http
  seq: 1336
}

get {
  url: {{base_url}}/api/marketplace/packages/__bruno_missing__/secret-readiness
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{denied_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
