meta {
  name: 0303 sessions-admin-registrations - Application read preserves the typed response contract
  type: http
  seq: 303
}

get {
  url: {{base_url}}/api/dashboard/registrations
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
