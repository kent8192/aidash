meta {
  name: 1015 memory-participants - Application read preserves the typed response contract
  type: http
  seq: 1015
}

get {
  url: {{base_url}}/api/workspaces/{{workspace_id}}/memory/participants
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"Bank":{"additionalProperties":false,"description":"Issued by the Home authority for a participant, independently of a definition version.","properties":{"home":{"type":"string"},"participant":{"description":"`None` is the explicitly published Workspace bank.","format":"uuid","type":["string","null"]},"tenant":{"type":"string"},"workspace":{"format":"uuid","type":"string"}},"required":["home","tenant","workspace","participant"],"type":"object"},"EntityRef":{"properties":{"id":{"type":"string"},"version":{"type":"string"}},"required":["id","version"],"type":"object"},"Participant":{"additionalProperties":false,"properties":{"agent":{"$ref":"#/components/schemas/EntityRef"},"bank":{"$ref":"#/components/schemas/Bank"},"id":{"format":"uuid","type":"string"},"revision":{"format":"int64","type":"integer"}},"required":["id","bank","agent","revision"],"type":"object"},"ParticipantPage":{"properties":{"items":{"items":{"$ref":"#/components/schemas/Participant"},"type":"array"},"next":{"format":"uuid","type":["string","null"]}},"required":["items","next"],"type":"object"}},"schema":{"$ref":"#/components/schemas/ParticipantPage"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json");expect(res.getBody()).to.eql({items:[],next:null}); });
}
