meta {
  name: 0611 generation-requests - Application read preserves the typed response contract
  type: http
  seq: 611
}

get {
  url: {{base_url}}/api/generation/{{tenant}}/requests
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

tests {
  test("Exact HTTP 200", function () { expect(res.getStatus()).to.equal(200); });
  test("Documented response fields and types", function () { const contract={"definitions":{"AgentNormalization":{"additionalProperties":false,"description":"Read-only registration metadata is compiled by the Node before publication.","properties":{"bindings":{"items":{"$ref":"#/components/schemas/NormalizedBinding"},"type":"array"},"registry_deployment":{"type":"string"},"schema_version":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"},"compaction_override":{"anyOf":[{"$ref":"#/components/schemas/QualifiedRef"},{"type":"null"}],"description":"Exact explicit compaction replacement, resolved by trusted registration."}},"required":["schema_version","registry_deployment","compaction_override","bindings"],"type":"object"},"Binding3":{"additionalProperties":false,"properties":{"alias":{"type":["string","null"]},"exposure":{"anyOf":[{"$ref":"#/components/schemas/BindingExposure"},{"type":"null"}],"description":"Only valid for Tools, bundles and Skills under the `deferred@1` policy."},"kind":{"$ref":"#/components/schemas/BindingKind"},"members":{"description":"An empty member list binds the entire bundle. IDs are unique within a bundle.","items":{"type":"string"},"type":"array"},"narrow":{"$ref":"#/components/schemas/Narrowing"},"target":{"$ref":"#/components/schemas/QualifiedRef"}},"required":["kind","target","narrow"],"type":"object"},"BindingExposure":{"description":"Per-Binding exposure under `deferred@1`. Absent means Deferred.","enum":["eager","deferred"],"type":"string"},"BindingKind":{"enum":["tool","bundle","skill","memory","source","decider","external_service"],"type":"string"},"BindingOrigin":{"description":"Only the registration resolver creates provenance; it is absent from writable Bindings.","enum":["required","default","explicit","skill_support","companion"],"type":"string"},"Concurrency":{"description":"Whether a tool's calls may share a Tool Batch. Registry configuration can\nonly lower a provider's declaration, never raise it.","oneOf":[{"description":"Every call runs alone, in the model's order.","enum":["sequential"],"type":"string"},{"description":"Read-only calls whose provider derives Resource Claims and an output bound.","enum":["shared_read"],"type":"string"}]},"Entry":{"additionalProperties":false,"properties":{"binding_normalization":{"anyOf":[{"$ref":"#/components/schemas/AgentNormalization"},{"type":"null"}]},"capabilities":{"default":[],"items":{"type":"string"},"type":"array"},"config":{"additionalProperties":true,"default":{},"type":"object"},"description":{"additionalProperties":{"type":"string"},"type":"object"},"id":{"type":"string"},"installation":{"anyOf":[{"$ref":"#/components/schemas/MarketplaceProjection"},{"type":"null"}]},"kind":{"type":"string"},"languages":{"default":[],"items":{"type":"string"},"type":"array"},"name":{"additionalProperties":{"type":"string"},"type":"object"},"schema":{"default":{}},"skills":{"default":[],"items":{"type":"string"},"type":"array"},"tags":{"default":[],"items":{"type":"string"},"type":"array"},"version":{"type":"string"}},"required":["id","version","kind","name","description","capabilities","tags","languages","skills","schema","config"],"type":"object"},"GenerationRequest":{"properties":{"admission_id":{"format":"uuid","type":["string","null"]},"agent_id":{"type":"string"},"agent_version":{"type":"string"},"created_at":{"format":"date-time","type":"string"},"definition":{"$ref":"#/components/schemas/Entry"},"depth":{"format":"int32","type":"integer"},"expires_at":{"format":"date-time","type":"string"},"grant_id":{"format":"uuid","type":["string","null"]},"home_node":{"description":"The address of the Node that owns the Task: this request's own Node for\na local request, the requesting Home for a foreign one.","type":"string"},"id":{"format":"uuid","type":"string"},"node":{"$ref":"#/components/schemas/NodeName","description":"The Node of the requesting Workspace."},"policy_id":{"type":"string"},"policy_revision":{"format":"int64","type":"integer"},"prepared":{"type":"boolean"},"quota_released":{"type":"boolean"},"reason":{"type":"string"},"root_subject":{"type":"string"},"status":{"type":"string"},"subject_chain":{"items":{"type":"string"},"type":"array"},"task_id":{"format":"uuid","type":"string"},"tenant":{"type":"string"},"token_limit":{"format":"int64","type":"integer"},"workspace_id":{"format":"uuid","type":"string"}},"required":["id","tenant","policy_id","policy_revision","task_id","node","home_node","prepared","grant_id","admission_id","workspace_id","root_subject","subject_chain","agent_id","agent_version","definition","status","reason","depth","token_limit","quota_released","expires_at","created_at"],"type":"object"},"MarketplaceProjection":{"additionalProperties":false,"properties":{"contract":{"format":"uint8","maximum":255,"minimum":0,"type":"integer"},"installation":{"type":"string"},"revision":{"format":"int64","type":"integer"},"tenant":{"type":"string"}},"required":["contract","tenant","installation","revision"],"type":"object"},"Narrowing":{"additionalProperties":false,"description":"No effect, replay, approval or disclosure field is accepted here. Concurrency\nsafety may only be lowered; a claim above the provider's is rejected.","properties":{"allowed_hosts":{"items":{"type":"string"},"type":["array","null"],"uniqueItems":true},"concurrency":{"anyOf":[{"$ref":"#/components/schemas/Concurrency"},{"type":"null"}]},"decision":{"anyOf":[{"$ref":"#/components/schemas/Restrictions"},{"type":"null"}]},"limits":{"additionalProperties":{"format":"uint64","minimum":0,"type":"integer"},"type":"object"},"scope":{"additionalProperties":{"items":{"type":"string"},"type":"array","uniqueItems":true},"type":"object"}},"type":"object"},"NodeName":{"description":"The identifier Aidash assigns to a Node, in the same form as a Tenant name:\n`<adjective>-<noun>-<8 random characters>`. Unique within its Deployment,\nnever changed and never reused.","type":"string"},"NormalizedBinding":{"additionalProperties":false,"properties":{"binding":{"$ref":"#/components/schemas/Binding3"},"origin":{"$ref":"#/components/schemas/BindingOrigin"}},"required":["binding","origin"],"type":"object"},"QualifiedRef":{"additionalProperties":false,"properties":{"id":{"type":"string"},"registry_deployment":{"type":"string"},"version":{"type":"string"}},"required":["registry_deployment","id","version"],"type":"object"},"Restrictions":{"additionalProperties":false,"description":"What a Binding may tighten. A lower threshold takes the conservative action\nat a lower probability: it keeps more content for compaction and blocks more\ncalls for approval. `preserve_recent` and `forbid_apply` apply to compaction\nonly; an approval Decider reads `threshold` and `max_calls_per_run`.","properties":{"forbid_apply":{"default":false,"type":"boolean"},"max_calls_per_run":{"description":"A lower per-Run call limit than the Decider version declares.","format":"uint64","minimum":0,"type":["integer","null"]},"preserve_recent":{"default":6,"description":"Events, or on the Native Projection Version Model Turns, never classified.","format":"uint","minimum":0,"type":"integer"},"threshold":{"default":"3fe0000000000000","description":"The probability at which an answer takes the conservative action; lower\nis stricter. A Route's own threshold is intersected in when it is asked.","type":"string"}},"required":["threshold","preserve_recent","forbid_apply","max_calls_per_run"],"type":"object"}},"schema":{"items":{"$ref":"#/components/schemas/GenerationRequest"},"type":"array"}}; function valid(value,schema){if(schema===true)return true;if(schema===false)return false;if(schema.$ref)return valid(value,contract.definitions[schema.$ref.split("/").pop().replace(/~1/g,"/").replace(/~0/g,"~")]);if(schema.anyOf)return schema.anyOf.some(item=>valid(value,item));if(schema.oneOf)return schema.oneOf.filter(item=>valid(value,item)).length===1;if(schema.allOf&&!schema.allOf.every(item=>valid(value,item)))return false;if(schema.enum&&!schema.enum.some(item=>JSON.stringify(item)===JSON.stringify(value)))return false;const types=Array.isArray(schema.type)?schema.type:schema.type?[schema.type]:[];if(types.length&&!types.some(type=>type==="null"?value===null:type==="array"?Array.isArray(value):type==="object"?value!==null&&typeof value==="object"&&!Array.isArray(value):type==="integer"?Number.isInteger(value):typeof value===type))return false;if(value!==null&&typeof value==="object"&&!Array.isArray(value)){if((schema.required||[]).some(field=>!(field in value)))return false;for(const [field,property] of Object.entries(schema.properties||{}))if(field in value&&!valid(value[field],property))return false;}if(Array.isArray(value)&&schema.items&&!value.every(item=>valid(item,schema.items)))return false;return true;}expect(valid(res.getBody(),contract.schema)).to.equal(true); });
  test("Application read preserves the typed response contract contract", function () { expect(res.getHeader("content-type")).to.include("application/json"); });
}
