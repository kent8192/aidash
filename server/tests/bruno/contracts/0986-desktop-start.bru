meta {
  name: 0986 desktop-start - Reject unknown broker input
  type: http
  seq: 986
}

post {
  url: {{base_url}}/auth/desktop/start
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"redirect_uri": "http://127.0.0.1:43217/callback", "state": "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss", "code_challenge": "2RMjpSmPO5-BTbKe-qJx8k-9zO390GJJG4q8jge3-2k", "unexpected": true}
}

tests {
  test("Exact HTTP 422", function () { expect(res.getStatus()).to.equal(422); });
  test("Rejection is diagnostic and does not disclose SQL or credentials", function () { const value=res.getBody(); const text=typeof value === "string" ? value : JSON.stringify(value); expect(text.length).to.be.greaterThan(0); expect(text).not.to.match(/postgres:\/\/|SELECT .* FROM |operator_token|peer_token/); });
}
