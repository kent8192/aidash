meta {
  name: 0113 desktop-consent - Desktop consent rejects wrong CSRF
  type: http
  seq: 47
}

post {
  url: {{base_url}}/auth/desktop/authorize
  body: formUrlEncoded
  auth: none
}

headers {
  Accept: application/json
  Cookie: {{session_cookie}}
  Origin: {{base_url}}
  X-Aidash-CSRF: {{csrf}}
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  request: {{desktop_request}}
  csrf: invalid
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
