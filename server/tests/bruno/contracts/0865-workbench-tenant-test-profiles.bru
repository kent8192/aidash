meta {
  name: 0865 workbench-tenant-test-profiles - Malformed bearer syntax is rejected
  type: http
  seq: 865
}

get {
  url: {{base_url}}/api/workbench/test-profiles/{{tenant}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Basic invalid
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
