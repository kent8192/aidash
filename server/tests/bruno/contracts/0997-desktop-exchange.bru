meta {
  name: 0997 desktop-exchange - Invalid verifier cannot issue a session
  type: http
  seq: 997
}

post {
  url: {{base_url}}/auth/desktop/exchange
  body: text
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:text {
  {"code": "short", "state": "state", "verifier": "invalid", "redirect_uri": "http://127.0.0.1:43217/callback"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
