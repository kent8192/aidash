meta {
  name: 1260 approval-rule-create - Forged bearer cannot reach a person's approval settings
  type: http
  seq: 1260
}

post {
  url: {{base_url}}/api/tenants/{{tenant}}/approval-rules/mine
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer forged
  Content-Type: application/json
}

body:text {
  {"kind": "tool_call", "target": "every", "effect": "ask"}
}

tests {
  test("Exact HTTP 401", function () { expect(res.getStatus()).to.equal(401); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"unauthorized"}); });
}
