meta {
  name: 1321 peer-graph-grant-keys - Subject bearer has no receiving-record administration authority
  type: http
  seq: 1321
}

get {
  url: {{base_url}}/api/authorization/{{tenant}}/peer-graph-grant-keys?source_deployment=aidash://bruno-unknown&source_identity=11111111-1111-4111-8111-111111111111
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{contract_token}}
}

tests {
  test("Exact HTTP 403", function () { expect(res.getStatus()).to.equal(403); });
  test("Stable authorization error envelope", function () { expect(res.getHeader("content-type")).to.include("application/json"); expect(res.getBody()).to.eql({error:"forbidden"}); });
}
