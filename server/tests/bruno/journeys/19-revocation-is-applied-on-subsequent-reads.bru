meta {
  name: Revocation is applied on subsequent reads
  type: http
  seq: 19
}

get {
  url: {{base_url}}/api/workspaces/{{workspace_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{owner_token}}
}

tests {
  test("HTTP 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody()).to.have.all.keys("error");
    expect(res.getBody().error).to.be.a("string");

  });
}
