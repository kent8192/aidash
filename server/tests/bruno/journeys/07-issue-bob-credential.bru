meta {
  name: Issue bob credential
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}/credentials
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{operator_token}}
}

body:json {
  {
    "subject": "bob",
    "expires_in_seconds": 3600
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().token).to.be.a("string");
    expect(res.getBody().credential.subject).to.equal("bob");
  });

  if (res.getStatus() === 200) {
    bru.setVar("denied_token", res.getBody().token);
    bru.setVar("denied_credential_id", res.getBody().credential.id);
  }
}
