meta {
  name: Create a task through the scoped API
  type: http
  seq: 14
}

post {
  url: {{base_url}}/api/workspaces/{{workspace_id}}/tasks
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "title": "Bruno task",
    "description": "Real API task creation",
    "requirements": {},
    "dependencies": [],
    "parent_id": null
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().workspace_id).to.equal(bru.getVar("workspace_id"));
    expect(res.getBody().status).to.equal("OPEN");
  });

  if (res.getStatus() === 200) {
    bru.setVar("task_id",res.getBody().id);
  }
}
