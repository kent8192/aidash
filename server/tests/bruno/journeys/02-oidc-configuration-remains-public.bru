meta {
  name: OIDC configuration remains public
  type: http
  seq: 2
}

get {
  url: {{base_url}}/auth/config
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    // A Self-hosted Deployment lists no Cloud regions.
    expect(res.getBody()).to.eql({cloud_regions:[],enabled:true,desktop_protocol:2,provider:"oidc",login_url:"/auth/login"});
  });
}
