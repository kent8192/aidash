meta {
  name: Update the owned workspace
  type: http
  seq: 10
}

patch {
  url: {{base_url}}/api/workspaces/{{workspace_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{owner_token}}
}

body:json {
  {
    "revision": 0,
    "state": {
      "bruno": true
    }
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().revision).to.equal(1);
    expect(res.getBody().state).to.eql({bruno:true});
  });
}
