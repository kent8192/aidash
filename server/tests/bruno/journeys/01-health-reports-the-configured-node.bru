meta {
  name: Health reports the configured node
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody()).to.eql({status:"ok",node_id:bru.getEnvVar("node_id")});
  });
}
