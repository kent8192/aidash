meta {
  name: Deployment Administrator cannot issue alice a credential
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}/credentials
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{deployment_administrator_token}}
}

body:json {
  {
    "subject": "alice",
    "expires_in_seconds": 3600
  }
}

script:post-response {
  // The harness minted this Tenant's first credentials from the host with
  // `manage issue-subject-credential` (#484); later journeys use them.
  bru.setVar("owner_token", bru.getEnvVar("alice_token"));
  bru.setVar("owner_credential_id", bru.getEnvVar("alice_credential_id"));
}

tests {
  test("HTTP 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
  test("Deployment Administrator holds no Tenant authority", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody()).to.eql({ error: "forbidden" });
  });
}
