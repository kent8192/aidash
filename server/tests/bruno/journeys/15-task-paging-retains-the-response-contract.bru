meta {
  name: Task paging retains the response contract
  type: http
  seq: 15
}

get {
  url: {{base_url}}/api/tasks?offset=0
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{owner_token}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody()).to.have.all.keys("tasks", "next_offset");
    expect(res.getBody().tasks.map(task => task.id)).to.include(bru.getVar("task_id"));
    expect(res.getBody().next_offset).to.equal(null);
  });
}
