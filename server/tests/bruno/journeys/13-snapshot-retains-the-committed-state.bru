meta {
  name: Snapshot retains the committed state
  type: http
  seq: 13
}

get {
  url: {{base_url}}/api/threads/{{thread_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{owner_token}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().thread.id).to.equal(bru.getVar("thread_id"));
    expect(res.getBody().thread.revision).to.equal(1);
    expect(res.getBody().thread.title).to.equal("Bruno");
    expect(res.getBody().tasks).to.eql([]);
  });
}
