meta {
  name: Revoke the owned bearer credential
  type: http
  seq: 18
}

post {
  url: {{base_url}}/api/authorization/{{tenant}}/credentials/{{owner_credential_id}}/revoke
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{operator_token}}
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("JSON response contract", function () {
    expect(res.getHeader("content-type")).to.include("application/json");
    expect(res.getBody().id).to.equal(bru.getVar("owner_credential_id"));
    expect(res.getBody().revoked_at).to.be.a("string");
  });
}
