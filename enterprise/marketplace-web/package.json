{
  "name": "aidash-marketplace-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wasm:dev && vite --host 127.0.0.1",
    "build:wasm": "node scripts/wasm.mjs release",
    "build:wasm:dev": "node scripts/wasm.mjs dev",
    "typecheck": "node scripts/wasm.mjs check && npm run typecheck:tools",
    "typecheck:tools": "tsc --noEmit",
    "build": "npm run build:wasm && npm run bundle",
    "bundle": "npm run typecheck:tools && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
