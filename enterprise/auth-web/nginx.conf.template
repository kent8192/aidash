server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # GCIP uses its configured HTTPS auth-domain iframe, including custom
    # domains, and the Google iframe API. No downstream product token enters JS.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://*.googleapis.com; frame-src https:; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location ~ ^/(login/|account(?:/|$)|logout(?:/|$)|oauth/|\.well-known/) {
        proxy_pass ${AUTHENTICATION_BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_redirect off;
    }

    location /assets/ {
        try_files $uri =404;
        expires 365d;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
