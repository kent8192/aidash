AIDASH_MARKETPLACE_LISTEN=127.0.0.1:8082
AIDASH_MARKETPLACE_ORIGIN=http://127.0.0.1:8082
AIDASH_MARKETPLACE_DATABASE_URL=postgres://marketplace_app:REPLACE@127.0.0.1/aidash
AIDASH_AUTH_ISSUER=http://127.0.0.1:8081
AIDASH_MARKETPLACE_CLIENT_ID=marketplace
AIDASH_MARKETPLACE_CLIENT_SECRET_FILE=/run/secrets/marketplace-client
AIDASH_MARKETPLACE_RESOURCE_CLIENT_ID=marketplace-resource
AIDASH_MARKETPLACE_RESOURCE_SECRET_FILE=/run/secrets/marketplace-resource
AIDASH_MARKETPLACE_BILLING_SECRET_FILE=/run/secrets/marketplace-billing
AIDASH_MARKETPLACE_ENROLLMENT_SECRET_FILE=/run/secrets/marketplace-enrollment
AIDASH_MARKETPLACE_RECALL_SECRET_FILE=/run/secrets/marketplace-recall
