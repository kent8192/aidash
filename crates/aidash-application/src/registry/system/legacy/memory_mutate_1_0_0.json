{
  "$defs": {
    "Bank": {
      "additionalProperties": false,
      "description": "Issued by the Home authority for a participant, independently of a definition version.",
      "properties": {
        "home": {
          "type": "string"
        },
        "participant": {
          "description": "`None` is the explicitly published Workspace bank.",
          "format": "uuid",
          "type": ["string", "null"]
        },
        "tenant": {
          "type": "string"
        },
        "workspace": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": ["home", "tenant", "workspace"],
      "type": "object"
    },
    "Change": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/Content"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "operation": {
              "const": "add",
              "type": "string"
            }
          },
          "required": ["operation", "id", "content"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "$ref": "#/$defs/Content"
            },
            "expected_revision": {
              "format": "int64",
              "type": "integer"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "operation": {
              "const": "correct",
              "type": "string"
            }
          },
          "required": ["operation", "id", "expected_revision", "content"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expected_revision": {
              "format": "int64",
              "type": "integer"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "operation": {
              "const": "delete",
              "type": "string"
            }
          },
          "required": ["operation", "id", "expected_revision"],
          "type": "object"
        }
      ]
    },
    "Content": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "learning": {
          "$ref": "#/$defs/Learning"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "type": "array"
        },
        "mental_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/MentalModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A recurring question, retained independently of the current generated answer."
        },
        "occurred": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "text",
        "kind",
        "learning",
        "verification",
        "entities",
        "evidence",
        "links"
      ],
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "description": "Explicit source/model-resolved names, including cross-language aliases.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["name", "category"],
      "type": "object"
    },
    "Evidence": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exact selected disclosure grant; source lineage is resolved at the Home.",
          "properties": {
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "publication",
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": ["kind", "id", "revision"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bank": {
              "$ref": "#/$defs/Bank"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "unit",
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": ["kind", "bank", "id", "revision"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "message",
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": ["kind", "id", "revision", "digest"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": ["kind", "id", "revision", "digest"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "type": "string"
            },
            "id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "run",
              "type": "string"
            },
            "revision": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": ["kind", "id", "revision", "digest"],
          "type": "object"
        }
      ]
    },
    "Kind": {
      "enum": ["world", "experience", "observation", "mental_model"],
      "type": "string"
    },
    "Learning": {
      "enum": ["fact", "preference", "procedure", "failure"],
      "type": "string"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/LinkKind"
        },
        "revision": {
          "format": "int64",
          "type": "integer"
        },
        "target": {
          "format": "uuid",
          "type": "string"
        },
        "weight": {
          "format": "double",
          "type": "number"
        }
      },
      "required": ["target", "revision", "kind", "weight"],
      "type": "object"
    },
    "LinkKind": {
      "enum": ["entity", "semantic", "temporal", "causes", "caused_by"],
      "type": "string"
    },
    "MentalModel": {
      "additionalProperties": false,
      "properties": {
        "automatic_refresh": {
          "type": "boolean"
        },
        "question": {
          "type": "string"
        }
      },
      "required": ["question", "automatic_refresh"],
      "type": "object"
    },
    "TimeRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": ["start", "end"],
      "type": "object"
    },
    "Verification": {
      "description": "Verification is separate from admission and model confidence.",
      "enum": ["unverified", "supported", "contradicted"],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changes": {
      "items": {
        "$ref": "#/$defs/Change"
      },
      "type": "array"
    }
  },
  "required": ["changes"],
  "title": "MemoryMutationInput",
  "type": "object"
}
