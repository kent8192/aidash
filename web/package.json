{
  "name": "aidash-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "npm run test:graph && npm run test:collaboration && playwright test",
    "test:graph": "node --experimental-strip-types --test unit/graph-fit.test.mjs unit/agent-graph.test.mjs unit/mesh-graph.test.mjs unit/graph-regions.test.mjs unit/graph-retry.test.mjs unit/graph-timeline.test.mjs",
    "generate:api": "orval --config orval.config.ts",
    "predev": "../scripts/generate-api.sh",
    "prebuild": "../scripts/generate-api.sh",
    "test:collaboration": "node --experimental-strip-types --test unit/collaboration.test.mjs unit/cytoscape-projection.test.mjs unit/display-labels.test.mjs unit/thread-messages.test.mjs unit/notifications.test.mjs unit/inference-progress.test.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "test:gcip": "playwright test --config playwright.gcip.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.23.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "3.34.1",
    "exceljs": "^4.4.0",
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "orval": "8.35.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "undici": "^7.29.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
