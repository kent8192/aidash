{
  "name": "aidash-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "npm run test:graph && npm run test:collaboration && playwright test",
    "test:graph": "node --experimental-strip-types --test unit/agent-graph.test.mjs",
    "generate:api": "orval --config orval.config.ts",
    "predev": "../scripts/generate-api.sh",
    "prebuild": "../scripts/generate-api.sh",
    "test:collaboration": "node --experimental-strip-types --test unit/collaboration.test.mjs unit/cytoscape-projection.test.mjs",
    "test:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.23.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.131.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.0",
    "cytoscape": "3.34.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "orval": "8.35.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3"
  },
  "overrides": {
    "undici": "^7.29.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
