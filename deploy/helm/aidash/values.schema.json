{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "node",
    "existingSecret",
    "server",
    "worker",
    "frontend",
    "terminationGracePeriodSeconds",
    "activation"
  ],
  "properties": {
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^aidash://[A-Za-z0-9-]{1,100}$" },
        "endpoint": { "type": "string" }
      }
    },
    "existingSecret": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "server": { "$ref": "#/definitions/role" },
    "worker": {
      "allOf": [
        { "$ref": "#/definitions/role" },
        {
          "type": "object",
          "required": ["slots"],
          "properties": {
            "slots": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        }
      ]
    },
    "frontend": {
      "type": "object",
      "required": ["replicas", "image", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 25 },
    "observability": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "type": ["integer", "null"],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "activation": {
      "type": "object",
      "required": ["namespace", "maxAgeSeconds", "maxBytes", "replicas"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "maxLength": 128 },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "role": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "existingSecret": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object", "required": ["requests", "limits"] }
      }
    }
  }
}
