{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "node",
    "existingSecret",
    "server",
    "worker",
    "frontend",
    "terminationGracePeriodSeconds",
    "activation",
    "sse"
  ],
  "properties": {
    "environment": {
      "type": "object",
      "properties": {
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "object",
          "properties": {
            "runscRoot": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "runsc": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "gvisorBin": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "ctr": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "cgroupRoot": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./-]+$"
            },
            "guardState": {
              "description": "Node-local guard state directory. Empty derives a release-specific path.",
              "type": "string",
              "pattern": "^(/[A-Za-z0-9_./-]+)?$"
            },
            "sentryBinaries": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9_./-]+$"
              },
              "minItems": 1
            }
          }
        },
        "gvisor": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]{8}\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "runner": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "guard": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "installer": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "integer",
              "minimum": 1
            },
            "memory_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "processes": {
              "description": "Guest RLIMIT_NPROC. The admission probe lowers its own hard limit to 8 (runner/probe.py fork_probe_limit) and cannot raise it, so smaller values crash-loop the Runner.",
              "type": "integer",
              "minimum": 8
            },
            "host_tasks": {
              "type": "integer",
              "minimum": 1
            },
            "working_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "temporary_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_seconds": {
              "description": "Operation time limit. The node guard rejects Python cells above 600 seconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "idle_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "sse": {
      "type": "object",
      "required": ["reconcileIntervalMs", "backpressureTimeoutSeconds"],
      "properties": {
        "reconcileIntervalMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 60000
        },
        "backpressureTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^aidash://[A-Za-z0-9-]{1,100}$" },
        "endpoint": { "type": "string" }
      }
    },
    "existingSecret": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "server": { "$ref": "#/definitions/role" },
    "worker": {
      "allOf": [
        { "$ref": "#/definitions/role" },
        {
          "type": "object",
          "required": ["slots"],
          "properties": {
            "slots": { "type": "integer", "minimum": 1, "maximum": 4 }
          }
        }
      ]
    },
    "frontend": {
      "type": "object",
      "required": ["replicas", "image", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        }
      }
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 25 },
    "observability": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "LoadBalancer", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": {
          "type": ["integer", "null"],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "activation": {
      "type": "object",
      "required": ["namespace", "maxAgeSeconds", "maxBytes", "replicas"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1, "maxLength": 128 },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "role": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "existingSecret": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object", "required": ["requests", "limits"] }
      }
    }
  }
}
