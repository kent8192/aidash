# Read literally by cli-backend --env-file; never source it.
# Direct HTTPS Messages API: no CLI installation, login, hooks or subprocess.
AIDASH_CLI_PROVIDER=claude
AIDASH_CLI_AUTH_MODE=oauth-token
# Full Anthropic model ID available to your account; no OpenRouter prefix.
AIDASH_CLI_MODEL=
# Choose a verified context budget, greater than max output below.
AIDASH_CLI_CONTEXT_WINDOW=
AIDASH_CLI_PORT=18190
AIDASH_CLI_TIMEOUT_SECONDS=120
AIDASH_CLI_MAX_OUTPUT_TOKENS=4096
# Paste your own setup-token here only in the private copy, never in this example.
CLAUDE_CODE_OAUTH_TOKEN=
