# Read only by cli-backend --env-file. Never source this file.
# Codex profiles currently fail closed at doctor/serve; see README.
AIDASH_CLI_PROVIDER=claude
AIDASH_CLI_AUTH_MODE=native
AIDASH_CLI_EXECUTABLE=claude
# Required: full model ID verified for your account, no alias or placeholder.
AIDASH_CLI_MODEL=
# Required: context budget verified against the selected model.
AIDASH_CLI_CONTEXT_WINDOW=
AIDASH_CLI_PORT=18190
AIDASH_CLI_TIMEOUT_SECONDS=120
AIDASH_CLI_MAX_OUTPUT_TOKENS=4096
AIDASH_CLI_WORK_DIR=private/cli-backends/work
# Optional absolute directory selected by the official CLI.
# CLAUDE_CONFIG_DIR=/absolute/path/to/claude-config
