{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aidash",
  "version": "0.1.0",
  "identifier": "dev.aidash.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Aidash",
        "width": 1440,
        "height": 1000,
        "minWidth": 760,
        "minHeight": 560,
        "url": "index.html",
        "useHttpsScheme": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:* http://[::1]:*; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
